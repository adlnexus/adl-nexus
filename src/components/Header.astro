---
import BrandLogo from './BrandLogo.astro';
import { equivalentLocaleRoute, languageNames, localeCodes, routeFor, uiCopy, type SiteLocale } from '../data/localization';

interface Props { dark?: boolean; lang?: SiteLocale; brandVariant?: 'default' | 'green'; homepage?: boolean; notFound?: boolean }
const { dark = false, lang = 'en', brandVariant = 'default', homepage = false, notFound = false } = Astro.props;
const path = Astro.url.pathname;
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const home = routeFor(lang);
const ui = uiCopy[lang];
const href = (route: string) => routeFor(lang, route);
const localeHref = (locale: SiteLocale) => notFound ? routeFor(locale) : equivalentLocaleRoute(path, locale);
const routeActive = (route: string) => active(href(route));
const logoVariant = dark ? 'white' : brandVariant === 'green' ? 'green' : 'full';
---
<header class:list={["site-header", { "site-header--dark": dark, "site-header--green": brandVariant === 'green', "site-header--home": homepage }]}>
  <div class="header-inner">
    <a class="brand" href={home} aria-label="ADL Nexus">
      <BrandLogo class="brand-logo brand-logo--page" variant={logoVariant} />
      <BrandLogo class="brand-logo brand-logo--menu" variant="white" />
    </a>

    <nav class="desktop-nav" aria-label={ui.navLabel}>
      <a class:list={{ active: path === home }} href={home}>{ui.nav.home}</a>
      <details class="nav-dropdown">
        <summary class:list={{ active: routeActive('/solutions') }}>{ui.nav.solutions} <span>⌄</span></summary>
        <div class="dropdown-panel">
          <a class="solution-link solution-link--pipedrive" href={href('/solutions/pipedrive')}><img src="/partners/pipedrive-logo.svg" alt="Pipedrive" width="120" height="30" /><small>{ui.solutionNotes.pipedrive}</small></a>
          <a class="solution-link solution-link--learnie" href={href('/solutions/learnie')}><img src="/partners/learnie-logo.png" alt="Learnie" width="120" height="44" /><small>{ui.solutionNotes.learnie}</small></a>
        </div>
      </details>
      <a class:list={{ active: routeActive('/services') }} href={href('/services')}>{ui.nav.services}</a>
      <a class:list={{ active: routeActive('/contact') }} href={href('/contact')}>{ui.nav.contact}</a>
    </nav>

    <div class="header-actions">
      <details class="language">
        <summary aria-label={`${lang.toUpperCase()} — ${ui.languageLabel}`}>{lang.toUpperCase()} <span aria-hidden="true">⌄</span></summary>
        <div>{localeCodes.map((locale) => <a class:list={{selected: locale === lang}} href={localeHref(locale)} hreflang={locale}>{languageNames[locale]}</a>)}</div>
      </details>
      <a class="header-cta" href={`${href('/contact')}#start-a-conversation`}>{ui.cta}</a>
      <details class="mobile-menu">
        <summary aria-label={ui.menuLabel} aria-controls="mobile-navigation" aria-expanded="false"><span></span><span></span></summary>
        <nav class="mobile-panel" id="mobile-navigation" aria-label={ui.navLabel}>
          <a href={home} aria-current={path === home ? 'page' : undefined}>{ui.nav.home}</a>
          <span class="mobile-label">{ui.nav.solutions}</span>
          <a href={href('/solutions/pipedrive')} aria-current={routeActive('/solutions/pipedrive') ? 'page' : undefined}>Pipedrive</a>
          <a href={href('/solutions/learnie')} aria-current={routeActive('/solutions/learnie') ? 'page' : undefined}>Learnie</a>
          <a href={href('/services')} aria-current={routeActive('/services') ? 'page' : undefined}>{ui.nav.services}</a>
          <a href={href('/contact')} aria-current={routeActive('/contact') ? 'page' : undefined}>{ui.nav.contact}</a>
          <div class="mobile-languages" aria-label={ui.languageLabel}>{localeCodes.map((locale) => <a class:list={{selected: locale === lang}} href={localeHref(locale)} hreflang={locale}>{locale.toUpperCase()}</a>)}</div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header { position: fixed; z-index: 50; top: 0; left: 0; width: 100%; color: var(--ink); }
  .site-header::before { content: ''; position: absolute; inset: 8px max(8px, calc((100% - var(--max)) / 2 - 20px)); border: 1px solid rgba(255,255,255,.6); border-radius: 999px; background: linear-gradient(135deg, rgba(255,253,251,.66), rgba(255,253,251,.46)); box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 6px 24px rgba(26,23,27,.06); -webkit-backdrop-filter: blur(24px) saturate(135%); backdrop-filter: blur(24px) saturate(135%); opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header::before { background: rgba(255,253,251,.92); }
  }
  .site-header.is-scrolled::before { opacity: 1; }
  .site-header:has(.mobile-menu[open])::before { opacity: 0; }
  .site-header .header-inner { position: relative; border-bottom-color: transparent; }
  .site-header--dark.is-scrolled:not(:has(.mobile-menu[open])) { color: var(--ink); }
  .site-header--dark.is-scrolled :global(.brand-logo--page) { filter: brightness(.15); }
  .site-header--dark { --accent: var(--accent-on-dark); --accent-dark: var(--white); --focus-color: var(--accent-on-dark); color: var(--white); }
  .site-header--green { --accent: #6861f2; --accent-dark: #6150e1; --focus-color: #6861f2; --cta-fill: var(--accent); --cta-hover: var(--accent-dark); --cta-shadow: none; color: #192435; }
  .header-inner { width: min(calc(100% - (2 * var(--pad))), var(--max)); height: 104px; display: grid; grid-template-columns: 165px 1fr auto; align-items: center; gap: 2rem; margin: auto; border-bottom: 1px solid currentColor; border-bottom-color: color-mix(in srgb, currentColor 20%, transparent); }
  .brand { width: max-content; display: block; }
  :global(.brand-logo) { width: 108px; height: auto; display: block; transition: filter .2s ease; }
  .site-header:not(.site-header--green):not(.site-header--dark) :global(.brand-logo--page) { filter: grayscale(1) brightness(.35); }
  :global(.brand-logo--menu) { display: none; }
  .desktop-nav { display: flex; align-items: center; justify-content: center; gap: clamp(1.1rem, 2.5vw, 2.6rem); }
  .desktop-nav > a, .nav-dropdown summary { position: relative; padding: .7rem 0; font-size: .79rem; font-weight: 650; cursor: pointer; list-style: none; }
  .desktop-nav > a::after, .nav-dropdown summary::after { position: absolute; right: 100%; bottom: 0; left: 0; height: 2px; background: var(--accent); content: ""; transition: right .2s ease; }
  .desktop-nav > a:hover::after, .desktop-nav > a.active::after, .nav-dropdown summary:hover::after, .nav-dropdown summary.active::after { right: 0; }
  .nav-dropdown summary::-webkit-details-marker, .language summary::-webkit-details-marker, .mobile-menu summary::-webkit-details-marker { display: none; }
  .nav-dropdown { position: relative; }
  .nav-dropdown summary span, .language summary span { margin-left: .3rem; }
  .dropdown-panel { position: absolute; top: calc(100% + 1rem); left: 50%; width: 560px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; padding: 1rem; border: 1px solid rgba(255,255,255,.6); border-radius: 26px; background: linear-gradient(135deg, rgba(255,253,251,.66), rgba(255,253,251,.46)); color: var(--ink); box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 6px 24px rgba(26,23,27,.06); -webkit-backdrop-filter: blur(24px) saturate(135%); backdrop-filter: blur(24px) saturate(135%); transform: translateX(-50%); }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .dropdown-panel { background: rgba(255,253,251,.92); }
  }
  .solution-link { --tile-tint: #d7f9d3; --tile-accent: #017737; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: .9rem; min-width: 0; min-height: 145px; padding: 1.5rem; border: 1px solid color-mix(in srgb, var(--tile-accent) 12%, white); border-radius: 20px; background: linear-gradient(135deg, #fffefa, var(--tile-tint)); color: #28342e; transition: box-shadow .2s ease, border-color .2s ease; }
  .solution-link--learnie { --tile-tint: #e3f1d4; --tile-accent: #0e8b44; }
  .solution-link::before { content: ''; position: absolute; inset: 0; background: color-mix(in srgb, var(--tile-accent) 9%, transparent); clip-path: polygon(100% 40%, 100% 100%, 52% 100%); pointer-events: none; }
  .solution-link img { position: relative; width: 120px; height: 36px; object-fit: contain; object-position: left center; }
  .solution-link small { position: relative; font-size: .9rem; font-weight: 450; line-height: 1.4; letter-spacing: -.015em; }
  .solution-link:hover, .solution-link:focus-visible { border-color: var(--tile-accent); box-shadow: 0 5px 16px color-mix(in srgb, var(--tile-accent) 12%, transparent); }
  .header-actions { display: flex; align-items: center; gap: .85rem; }
  .language { position: relative; }
  .language summary { padding: .75rem; cursor: pointer; font-size: .75rem; font-weight: 800; list-style: none; }
  .language div { position: absolute; right: 0; top: calc(100% + .7rem); width: 170px; padding: .4rem; background: var(--white); color: var(--ink); box-shadow: 0 15px 40px rgba(0,0,0,.14); }
  .language a { display: block; padding: .8rem; font-size: .78rem; }
  .language a:hover { background: var(--paper); }
  .language .selected::after { float: right; color: var(--accent); content: "●"; }
  .header-cta { display: flex; min-height: 48px; align-items: center; gap: 1.2rem; padding: .7rem 1rem; border-radius: var(--radius); background: var(--cta-fill); color: var(--white); box-shadow: var(--cta-shadow); font-size: .74rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .header-cta:hover, .header-cta:focus-visible { background: var(--cta-hover); }
  .mobile-menu { display: none; }
  @media (max-width: 1000px) {
    .header-inner { grid-template-columns: 1fr auto; height: 84px; transition: color .28s ease, border-color .28s ease; }
    .brand { display: grid; }
    :global(.brand-logo--page), :global(.brand-logo--menu) { grid-area: 1 / 1; transition: opacity .28s ease, visibility 0s linear .28s; }
    :global(.brand-logo--menu) { display: block; opacity: 0; visibility: hidden; }
    .desktop-nav, .language { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu[open] { --focus-color: var(--accent-on-dark); }
    .mobile-menu > summary { position: relative; z-index: 2; width: 48px; height: 48px; border: 1px solid #656168; border-radius: 50%; background: linear-gradient(145deg, #747078, #55515a); color: var(--white); box-shadow: 0 1px 0 rgba(26, 23, 27, .18), 0 3px 8px rgba(26, 23, 27, .12), inset 0 1px 0 rgba(255, 255, 255, .12); cursor: pointer; list-style: none; transition: color .28s ease, border-color .28s ease, background-color .28s ease, box-shadow .2s ease; }
    .mobile-menu > summary:hover, .mobile-menu > summary:focus-visible { border-color: #817b86; box-shadow: 0 1px 0 rgba(26, 23, 27, .2), 0 4px 10px rgba(26, 23, 27, .16), inset 0 1px 0 rgba(255, 255, 255, .18); }
    .mobile-menu > summary span { position: absolute; top: calc(50% - .5px); left: calc(50% - 10px); width: 20px; height: 1px; background: currentColor; transform-origin: center; transition: transform .28s cubic-bezier(.2, .8, .2, 1); }
    .mobile-menu > summary span:first-child { transform: translateY(-4px); }
    .mobile-menu > summary span:last-child { transform: translateY(4px); }
    .mobile-menu.is-open > summary { border-color: #ffbd86; background: linear-gradient(145deg, #ffcb91, #f49c55); color: var(--ink); box-shadow: 0 2px 0 rgba(0, 0, 0, .3), 0 6px 14px rgba(0, 0, 0, .2), inset 0 1px 0 rgba(255, 255, 255, .45); }
    .mobile-menu > summary:active { box-shadow: 0 1px 2px rgba(96, 64, 43, .12), inset 0 2px 3px rgba(96, 64, 43, .16); }
    .mobile-menu.is-open > summary span:first-child { transform: rotate(45deg); }
    .mobile-menu.is-open > summary span:last-child { transform: rotate(-45deg); }
    .mobile-panel { position: fixed; z-index: -1; inset: 0; display: flex; flex-direction: column; justify-content: flex-start; gap: .15rem; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; padding: 7rem var(--pad) max(2rem, env(safe-area-inset-bottom)); background: var(--ink); color: var(--white); opacity: 0; pointer-events: none; visibility: hidden; transition: opacity .28s ease, visibility 0s linear .28s; }
    .mobile-panel::before { position: fixed; inset: 0; background-image: var(--menu-ribbons, url('/brand/adl-nexus-hero-bands.svg')); background-position: var(--menu-ribbon-position, 58% center); background-size: var(--menu-ribbon-size, cover); background-repeat: no-repeat; content: ""; opacity: .28; mask-image: linear-gradient(90deg, rgba(0, 0, 0, .3), #000 75%); pointer-events: none; }
    .mobile-menu.is-open .mobile-panel { opacity: 1; pointer-events: auto; visibility: visible; transition-delay: 0s; }
    .mobile-panel > * { position: relative; z-index: 1; opacity: 0; transform: translateY(6px); transition: opacity .2s ease, transform .28s cubic-bezier(.2, .8, .2, 1); }
    .mobile-menu.is-open .mobile-panel > * { opacity: 1; transform: translateY(0); }
    .mobile-panel a { width: fit-content; max-width: 100%; min-height: 44px; display: flex; align-items: center; flex-shrink: 0; padding-block: .2rem; font-size: clamp(1.8rem, 7vw, 3rem); font-weight: 760; letter-spacing: -.055em; line-height: 1.1; overflow-wrap: anywhere; }
    .mobile-panel a:hover, .mobile-panel a:focus-visible, .mobile-panel a[aria-current="page"] { color: var(--accent-on-dark); }
    .mobile-panel a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--accent-on-dark); text-decoration-thickness: 3px; text-underline-offset: .2em; }
    .mobile-panel .mobile-label { margin-top: .8rem; color: var(--accent-on-dark); font-size: .7rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
    .mobile-panel .mobile-label + a, .mobile-panel .mobile-label + a + a { margin-left: .15rem; padding-left: 1rem; border-left: 2px solid var(--accent-on-dark); font-size: clamp(1.25rem, 5vw, 2rem); }
    .mobile-languages { display: flex; gap: .5rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--warm-grey) 42%, transparent); }
    .mobile-panel .mobile-languages a { display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid color-mix(in srgb, var(--warm-grey) 55%, transparent); background: var(--ink); color: var(--white); font-size: .7rem; letter-spacing: .08em; }
    .mobile-panel .mobile-languages a.selected, .mobile-panel .mobile-languages a:hover { border-color: var(--accent-on-dark); background: var(--accent-on-dark); color: var(--ink); }
    .header-inner:has(.mobile-menu.is-open) { color: var(--white); border-bottom-color: rgba(255, 255, 255, .2); }
    .header-inner:has(.mobile-menu.is-open) :global(.brand-logo--page) { opacity: 0; visibility: hidden; }
    .header-inner:has(.mobile-menu.is-open) :global(.brand-logo--menu) { opacity: 1; visibility: visible; transition-delay: 0s; }
    .header-inner:not(:has(.mobile-menu.is-open)) :global(.brand-logo--page) { transition-delay: 0s; }
    .header-cta { transition: background-color .28s ease, color .28s ease; }
    .header-inner:has(.mobile-menu.is-open) .header-cta { background: var(--cta-fill); color: var(--white); }
  }
  @media (max-width: 1000px) and (max-height: 720px) {
    .mobile-panel { justify-content: flex-start; }
    .mobile-panel a { font-size: clamp(1.35rem, 4.5vh, 2rem); }
    .mobile-panel .mobile-label + a, .mobile-panel .mobile-label + a + a { font-size: clamp(1.1rem, 3.7vh, 1.6rem); }
  }
  @media (max-width: 520px) { .header-cta { display: none; } :global(.brand-logo) { width: 92px; } }
  @media (prefers-reduced-motion: reduce) {
    .site-header::before { transition: none; }
    .header-inner, .header-cta, .solution-link, :global(.brand-logo), .mobile-panel, .mobile-panel > *, .mobile-menu > summary, .mobile-menu > summary span { transition: none; }
  }
</style>

<script>
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  if (siteHeader) {
    const updateHeader = () => siteHeader.classList.toggle('is-scrolled', window.scrollY > 24);
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }
  if (window.location.search) {
    document.querySelectorAll<HTMLAnchorElement>('.language a[hreflang], .mobile-languages a[hreflang]').forEach((link) => {
      const target = new URL(link.href, window.location.origin);
      target.search = window.location.search;
      link.href = `${target.pathname}${target.search}`;
    });
  }
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const mobileSummary = mobileMenu?.querySelector<HTMLElement>(':scope > summary');
  const mobilePanel = mobileMenu?.querySelector<HTMLElement>('.mobile-panel');
  const backgroundState = new Map<HTMLElement, boolean>();
  const mobileBreakpoint = window.matchMedia('(max-width: 1000px)');
  let closeTimer: number | undefined;
  const alignMenuRibbons = () => {
    if (!mobilePanel) return;
    const ribbons = document.querySelector<SVGSVGElement>('.home-ribbons-ready .home-ribbons svg');
    if (ribbons) {
      // Reuse the actual responsive homepage geometry, not the older static art.
      const copy = ribbons.cloneNode(true) as SVGSVGElement;
      copy.querySelector('g')?.removeAttribute('mask');
      const rect = ribbons.getBoundingClientRect();
      mobilePanel.style.setProperty('--menu-ribbons', `url("data:image/svg+xml,${encodeURIComponent(new XMLSerializer().serializeToString(copy))}")`);
      mobilePanel.style.setProperty('--menu-ribbon-size', `${rect.width}px ${rect.height}px`);
      mobilePanel.style.setProperty('--menu-ribbon-position', `${rect.left}px ${rect.top}px`);
    } else {
      const hero = document.querySelector<HTMLElement>('.page-hero, .home-hero');
      if (!hero) return;
      const rect = hero.getBoundingClientRect();
      const scale = Math.max(rect.width / 800, rect.height / 900);
      const art = getComputedStyle(hero, '::before');
      const shift = art.transform === 'none' ? 0 : new DOMMatrixReadOnly(art.transform).m41;
      mobilePanel.style.setProperty('--menu-ribbon-size', `${800 * scale}px ${900 * scale}px`);
      mobilePanel.style.setProperty('--menu-ribbon-position', `${rect.left + (rect.width - 800 * scale) * .58 + shift}px ${rect.top + (rect.height - 900 * scale) / 2}px`);
    }
  };
  window.addEventListener('resize', () => {
    if (mobileMenu?.open) requestAnimationFrame(alignMenuRibbons);
  });

  const closeMobileMenu = (immediate = false) => {
    if (!mobileMenu?.open) return;
    window.clearTimeout(closeTimer);
    mobileMenu.classList.remove('is-open');
    mobileMenu.classList.toggle('is-closing', !immediate);
    mobileSummary?.setAttribute('aria-expanded', 'false');

    const finish = () => {
      mobileMenu.open = false;
      mobileMenu.classList.remove('is-closing');
      document.body.classList.remove('menu-open');
      backgroundState.forEach((wasInert, element) => { element.inert = wasInert; });
      backgroundState.clear();
    };

    if (immediate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) finish();
    else closeTimer = window.setTimeout(finish, 280);
  };

  mobileSummary?.addEventListener('click', (event) => {
    if (!mobileBreakpoint.matches || !mobileMenu) return;
    event.preventDefault();
    if (mobileMenu.open) {
      closeMobileMenu();
      return;
    }

    window.clearTimeout(closeTimer);
    document.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((detail) => {
      if (detail !== mobileMenu) detail.open = false;
    });
    alignMenuRibbons();
    mobileMenu.open = true;
    mobileSummary.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
    document.querySelectorAll<HTMLElement>('main, footer').forEach((element) => {
      backgroundState.set(element, element.inert);
      element.inert = true;
    });
    requestAnimationFrame(() => mobileMenu.classList.add('is-open'));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Tab' && mobileMenu?.open && mobileSummary && mobilePanel) {
      const controls = [mobileSummary, ...mobilePanel.querySelectorAll<HTMLAnchorElement>('a[href]')];
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
    if (event.key === 'Escape' && mobileMenu?.open) {
      closeMobileMenu();
      mobileSummary?.focus();
    }
  });

  mobilePanel?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a[href]')) closeMobileMenu(true);
  });

  mobileBreakpoint.addEventListener('change', (event) => {
    if (!event.matches) closeMobileMenu(true);
  });

  document.querySelectorAll<HTMLDetailsElement>('details:not(.mobile-menu)').forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (!detail.open) return;
      document.querySelectorAll<HTMLDetailsElement>('details').forEach((other) => {
        if (other !== detail && other !== mobileMenu) other.open = false;
      });
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('details[open]:not(.mobile-menu)').forEach(detail => {
      detail.open = false;
      detail.querySelector('summary')?.focus();
    });
  });
  document.addEventListener('click', event => {
    document.querySelectorAll<HTMLDetailsElement>('details[open]:not(.mobile-menu)').forEach(detail => {
      if (!detail.contains(event.target as Node)) detail.open = false;
    });
  });
</script>
