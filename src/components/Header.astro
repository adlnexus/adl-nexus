---
import { equivalentLocaleRoute, languageNames, localeCodes, routeFor, uiCopy, type SiteLocale } from '../data/localization';

interface Props { dark?: boolean; lang?: SiteLocale }
const { dark = false, lang = 'en' } = Astro.props;
const path = Astro.url.pathname;
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const home = routeFor(lang);
const ui = uiCopy[lang];
const href = (route: string) => routeFor(lang, route);
const localeHref = (locale: SiteLocale) => equivalentLocaleRoute(path, locale);
const routeActive = (route: string) => active(href(route));
---
<header class:list={["site-header", { "site-header--dark": dark }]}>
  <div class="header-inner">
    <a class="brand" href={home} aria-label={`ADL Nexus — ${ui.nav.home}`}>
      <span class="brand-main">ADL</span>
      <span class="brand-sub">Nexus</span>
    </a>

    <nav class="desktop-nav" aria-label={ui.navLabel}>
      <a class:list={{ active: path === home }} href={home}>{ui.nav.home}</a>
      <details class="nav-dropdown">
        <summary class:list={{ active: routeActive('/solutions') }}>{ui.nav.solutions} <span>⌄</span></summary>
        <div class="dropdown-panel">
          <a href={href('/solutions/pipedrive')}><span>01</span><strong>Pipedrive</strong><small>{ui.solutionNotes.pipedrive}</small></a>
          <a href={href('/solutions/learnie')}><span>02</span><strong>Learnie</strong><small>{ui.solutionNotes.learnie}</small></a>
        </div>
      </details>
      <a class:list={{ active: routeActive('/services') }} href={href('/services')}>{ui.nav.services}</a>
      <a class:list={{ active: routeActive('/about') }} href={href('/about')}>{ui.nav.about}</a>
      <a class:list={{ active: routeActive('/insights') }} href={href('/insights')}>{ui.nav.insights}</a>
      <a class:list={{ active: routeActive('/contact') }} href={href('/contact')}>{ui.nav.contact}</a>
    </nav>

    <div class="header-actions">
      <details class="language">
        <summary aria-label={ui.languageLabel}>{lang.toUpperCase()} <span>⌄</span></summary>
        <div>{localeCodes.map((locale) => <a class:list={{selected: locale === lang}} href={localeHref(locale)} hreflang={locale}>{languageNames[locale]}</a>)}</div>
      </details>
      <a class="header-cta" href={href('/contact')}>{ui.cta} <span>↗</span></a>
      <details class="mobile-menu">
        <summary aria-label={ui.menuLabel} aria-controls="mobile-navigation" aria-expanded="false"><span></span><span></span></summary>
        <div class="mobile-panel" id="mobile-navigation">
          <a href={home}>{ui.nav.home}</a>
          <span class="mobile-label">{ui.nav.solutions}</span>
          <a href={href('/solutions/pipedrive')}>Pipedrive</a>
          <a href={href('/solutions/learnie')}>Learnie</a>
          <a href={href('/services')}>{ui.nav.services}</a>
          <a href={href('/about')}>{ui.nav.about}</a>
          <a href={href('/insights')}>{ui.nav.insights}</a>
          <a href={href('/contact')}>{ui.nav.contact}</a>
          <div class="mobile-languages" aria-label={ui.languageLabel}>{localeCodes.map((locale) => <a class:list={{selected: locale === lang}} href={localeHref(locale)} hreflang={locale}>{locale.toUpperCase()}</a>)}</div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header { position: absolute; z-index: 50; top: 0; left: 0; width: 100%; color: var(--ink); }
  .site-header--dark { color: var(--white); }
  .header-inner { width: min(calc(100% - (2 * var(--pad))), var(--max)); height: 104px; display: grid; grid-template-columns: 185px 1fr auto; align-items: center; gap: 2rem; margin: auto; border-bottom: 1px solid currentColor; border-bottom-color: color-mix(in srgb, currentColor 20%, transparent); }
  .brand { width: max-content; display: grid; line-height: .78; text-transform: uppercase; }
  .brand-main { font-size: 2rem; font-weight: 900; letter-spacing: -.07em; }
  .brand-main::first-letter { color: var(--red); }
  .brand-sub { margin-top: .45rem; font-size: .57rem; font-weight: 800; letter-spacing: .27em; }
  .desktop-nav { display: flex; align-items: center; justify-content: center; gap: clamp(1.1rem, 2.5vw, 2.6rem); }
  .desktop-nav > a, .nav-dropdown summary { position: relative; padding: .7rem 0; font-size: .79rem; font-weight: 650; cursor: pointer; list-style: none; }
  .desktop-nav > a::after, .nav-dropdown summary::after { position: absolute; right: 100%; bottom: 0; left: 0; height: 2px; background: var(--red); content: ""; transition: right .2s ease; }
  .desktop-nav > a:hover::after, .desktop-nav > a.active::after, .nav-dropdown summary:hover::after, .nav-dropdown summary.active::after { right: 0; }
  .nav-dropdown summary::-webkit-details-marker, .language summary::-webkit-details-marker, .mobile-menu summary::-webkit-details-marker { display: none; }
  .nav-dropdown { position: relative; }
  .nav-dropdown summary span, .language summary span { margin-left: .3rem; }
  .dropdown-panel { position: absolute; top: calc(100% + 1rem); left: 50%; width: 360px; display: grid; grid-template-columns: 1fr 1fr; padding: .55rem; background: var(--white); color: var(--ink); box-shadow: 0 20px 60px rgba(0,0,0,.18); transform: translateX(-50%); }
  .dropdown-panel a { display: grid; grid-template-columns: auto 1fr; gap: .3rem .75rem; padding: 1.15rem; }
  .dropdown-panel a:hover { background: var(--paper); }
  .dropdown-panel span { grid-row: 1 / 3; color: var(--red); font-size: .64rem; font-weight: 800; }
  .dropdown-panel small { color: var(--muted); }
  .header-actions { display: flex; align-items: center; gap: .85rem; }
  .language { position: relative; }
  .language summary { padding: .75rem; cursor: pointer; font-size: .75rem; font-weight: 800; list-style: none; }
  .language div { position: absolute; right: 0; top: calc(100% + .7rem); width: 170px; padding: .4rem; background: var(--white); color: var(--ink); box-shadow: 0 15px 40px rgba(0,0,0,.14); }
  .language a { display: block; padding: .8rem; font-size: .78rem; }
  .language a:hover { background: var(--paper); }
  .language .selected::after { float: right; color: var(--red); content: "●"; }
  .header-cta { display: flex; min-height: 48px; align-items: center; gap: 1.2rem; padding: .7rem 1rem; background: var(--red); color: var(--white); font-size: .74rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .header-cta:hover { background: var(--red-dark); }
  .mobile-menu { display: none; }
  @media (max-width: 1000px) {
    .header-inner { grid-template-columns: 1fr auto; height: 84px; }
    .desktop-nav, .language { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu > summary { position: relative; z-index: 2; width: 48px; height: 48px; display: grid; place-content: center; gap: 7px; border: 1px solid currentColor; cursor: pointer; list-style: none; transition: border-color .25s ease, background-color .25s ease; }
    .mobile-menu > summary span { width: 20px; height: 1px; background: currentColor; transform-origin: center; transition: transform .35s cubic-bezier(.2, .8, .2, 1); }
    .mobile-menu.is-open > summary { border-color: rgba(255,255,255,.34); background: rgba(255,255,255,.06); color: var(--white); }
    .mobile-menu.is-open > summary span:first-child { transform: translateY(4px) rotate(45deg); }
    .mobile-menu.is-open > summary span:last-child { transform: translateY(-4px) rotate(-45deg); }
    .mobile-panel { position: fixed; z-index: -1; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: .25rem; overflow-y: auto; padding: 6rem var(--pad) 2rem; background: linear-gradient(145deg, #111113 0%, #18181c 58%, #231619 100%); color: var(--white); clip-path: inset(0 0 100% 0); opacity: 0; pointer-events: none; visibility: hidden; transition: clip-path .48s cubic-bezier(.76, 0, .24, 1), opacity .3s ease, visibility 0s linear .48s; }
    .mobile-panel::before { position: fixed; right: -22vw; bottom: -38vw; width: min(88vw, 560px); aspect-ratio: 1; border: clamp(2.2rem, 10vw, 5rem) solid var(--red); content: ""; opacity: .16; transform: rotate(34deg); pointer-events: none; }
    .mobile-menu.is-open .mobile-panel { clip-path: inset(0); opacity: 1; pointer-events: auto; visibility: visible; transition-delay: 0s; }
    .mobile-panel > * { position: relative; z-index: 1; opacity: 0; transform: translateY(18px); transition: opacity .28s ease, transform .38s cubic-bezier(.2, .8, .2, 1); }
    .mobile-menu.is-open .mobile-panel > * { opacity: 1; transform: translateY(0); }
    .mobile-menu.is-open .mobile-panel > :nth-child(1) { transition-delay: .16s; }
    .mobile-menu.is-open .mobile-panel > :nth-child(2) { transition-delay: .19s; }
    .mobile-menu.is-open .mobile-panel > :nth-child(3) { transition-delay: .22s; }
    .mobile-menu.is-open .mobile-panel > :nth-child(4) { transition-delay: .25s; }
    .mobile-menu.is-open .mobile-panel > :nth-child(5) { transition-delay: .28s; }
    .mobile-menu.is-open .mobile-panel > :nth-child(6) { transition-delay: .31s; }
    .mobile-menu.is-open .mobile-panel > :nth-child(7) { transition-delay: .34s; }
    .mobile-menu.is-open .mobile-panel > :nth-child(8) { transition-delay: .37s; }
    .mobile-menu.is-open .mobile-panel > :nth-child(9) { transition-delay: .4s; }
    .mobile-panel a { width: fit-content; font-size: clamp(1.8rem, 7vw, 3.5rem); font-weight: 700; letter-spacing: -.045em; }
    .mobile-panel a:hover { color: var(--red); }
    .mobile-panel .mobile-label { margin-top: 1rem; color: #888; font-size: .7rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
    .mobile-panel .mobile-label + a, .mobile-panel .mobile-label + a + a { margin-left: 1rem; font-size: clamp(1.3rem, 5vw, 2.4rem); }
    .mobile-languages { display: flex; gap: .5rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #333; }
    .mobile-panel .mobile-languages a { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid #45454a; color: #a8a8ae; font-size: .7rem; letter-spacing: .08em; }
    .mobile-panel .mobile-languages a.selected { border-color: var(--red); color: var(--white); }
  }
  @media (max-width: 1000px) and (max-height: 720px) {
    .mobile-panel { justify-content: flex-start; }
    .mobile-panel a { font-size: clamp(1.35rem, 4.5vh, 2rem); }
    .mobile-panel .mobile-label + a, .mobile-panel .mobile-label + a + a { font-size: clamp(1.1rem, 3.7vh, 1.6rem); }
  }
  @media (max-width: 520px) { .header-cta { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .mobile-panel, .mobile-panel > *, .mobile-menu > summary span { transition: none; }
  }
</style>

<script>
  if (window.location.search) {
    document.querySelectorAll<HTMLAnchorElement>('.language a[hreflang], .mobile-languages a[hreflang]').forEach((link) => {
      const target = new URL(link.href, window.location.origin);
      target.search = window.location.search;
      link.href = `${target.pathname}${target.search}`;
    });
  }
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const mobileSummary = mobileMenu?.querySelector<HTMLElement>(':scope > summary');
  const mobileBreakpoint = window.matchMedia('(max-width: 1000px)');
  let closeTimer: number | undefined;

  const closeMobileMenu = (immediate = false) => {
    if (!mobileMenu?.open) return;
    window.clearTimeout(closeTimer);
    mobileMenu.classList.remove('is-open');
    mobileMenu.classList.toggle('is-closing', !immediate);
    mobileSummary?.setAttribute('aria-expanded', 'false');

    const finish = () => {
      mobileMenu.open = false;
      mobileMenu.classList.remove('is-closing');
      document.body.classList.remove('menu-open');
    };

    if (immediate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) finish();
    else closeTimer = window.setTimeout(finish, 480);
  };

  mobileSummary?.addEventListener('click', (event) => {
    if (!mobileBreakpoint.matches || !mobileMenu) return;
    event.preventDefault();
    if (mobileMenu.open) {
      closeMobileMenu();
      return;
    }

    window.clearTimeout(closeTimer);
    document.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((detail) => {
      if (detail !== mobileMenu) detail.open = false;
    });
    mobileMenu.open = true;
    mobileSummary.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
    requestAnimationFrame(() => mobileMenu.classList.add('is-open'));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu?.open) {
      closeMobileMenu();
      mobileSummary?.focus();
    }
  });

  mobileBreakpoint.addEventListener('change', (event) => {
    if (!event.matches) closeMobileMenu(true);
  });

  document.querySelectorAll<HTMLDetailsElement>('details:not(.mobile-menu)').forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (!detail.open) return;
      document.querySelectorAll<HTMLDetailsElement>('details').forEach((other) => {
        if (other !== detail && other !== mobileMenu) other.open = false;
      });
    });
  });
</script>
