---
import { routeFor, type SiteLocale } from '../data/localization';

interface Props {
  lang?: SiteLocale;
  eyebrow: string;
  first: string;
  accent: string;
  support: string;
  cta: string;
}

const {
  lang = 'en',
  eyebrow,
  first,
  accent,
  support,
  cta,
} = Astro.props;

---
<section class="home-hero">
  <div class="hero-bands" aria-hidden="true"></div>

  <div class="home-hero-grid container">
    <div class="home-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display">
        <span>{first}</span>
        <strong>{accent}</strong>
      </h1>
      <p class="home-hero-lead">{support}</p>
      <a class="button button--primary" href={`${routeFor(lang, '/contact')}#start-a-conversation`}>{cta}</a>
    </div>

  </div>

</section>

<style>
  .home-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 7.5rem 0 1.5rem;
    background: var(--hero-surface);
    color: var(--ink);
  }

  .home-hero-grid {
    position: relative;
    z-index: 3;
    flex: 1;
    align-items: start;
    padding-block: clamp(2.5rem, 6vh, 5rem);
  }

  .home-hero-copy {
    position: relative;
    z-index: 2;
    max-width: 700px;
  }

  .home-hero .eyebrow { color: #d95f26; }

  .home-hero .display > span,
  .home-hero .display > strong { display: block; }

  .home-hero .display strong {
    color: var(--headline-accent);
    font-weight: inherit;
  }

  @media (max-width: 900px) {
    .home-hero { min-height: 100svh; padding-top: 6.5rem; }
    .home-hero-grid {
      flex: 1 1 auto;
      align-items: start;
      gap: 0;
      padding-block: 5.5rem 2rem;
    }
  }

  @media (max-width: 600px) {
    .home-hero-grid { padding-bottom: 1.5rem; }
    .home-hero-lead { max-width: 31rem; }
  }
</style>
