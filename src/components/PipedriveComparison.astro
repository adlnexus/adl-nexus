---
import PipedriveCarouselControls from './PipedriveCarouselControls.astro';
import type { PipedriveDetailedCopy } from '../data/pipedrive';
import { pipedriveTrialHref } from '../data/pipedrive';
interface Props { lang: 'en' | 'sr' | 'es'; detail: PipedriveDetailedCopy; demoHref: string }
const { lang, detail, demoHref } = Astro.props;
const sr = lang === 'sr';
const es = lang === 'es';
---
<section class="comparison" id="pipedrive-challenges" aria-labelledby="comparison-title" data-comparison>
  <div class="container">
    <header><p class="label">{detail.pain.eyebrow}</p><h2 id="comparison-title">{detail.pain.title}</h2></header>
    <div id="comparison-slides" class="slides" tabindex="0" aria-label={detail.pain.title}>
      {detail.pain.items.map((problem, i) => <article class="pair" data-slide role="group" aria-label={`${i + 1} / 3: ${problem.title}`}>
        <div class="card problem"><p class="label">{es ? 'El reto' : sr ? 'Problem' : 'The challenge'}</p><h3>{problem.title}</h3><p>{problem.text}</p></div>
        <span class="arrow" aria-hidden="true">→</span>
        <div class="card solution"><p class="label">{es ? 'Cómo ayuda Pipedrive' : sr ? 'Kako Pipedrive pomaže' : 'How Pipedrive helps'}</p><h3>{detail.outcomes[i].title}</h3>{detail.outcomes[i].text.split('\n\n').map(p => <p>{p}</p>)}</div>
      </article>)}
    </div>
    <PipedriveCarouselControls lang={lang} trackId="comparison-slides" />
    <p class="summary">{detail.pain.summary}</p>
    <div class="actions"><a class="button demo" href={demoHref}>{detail.hero.demo}</a><div class="trial-wrap"><a class="button trial pd-trial-cta" href={pipedriveTrialHref} target="_blank" rel="sponsored noopener noreferrer">{detail.hero.trial}</a><small>{detail.hero.trialNote}</small></div></div>
  </div>
</section>
<style>
  .comparison { padding: clamp(3.5rem, 6vw, 6rem) 0; background: #faf8f1; color: #262626; --focus-color: #1f5b49; scroll-margin-top: 7rem; }
  header { max-width: 850px; margin: 0 auto 2.5rem; text-align: center; }
  .label { margin: 0 0 1rem; color: #1f5b49; font-weight: 750; font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; }
  h2 { margin: 0; color: #1f5b49; font-size: clamp(2rem, 3.5vw, 3.5rem); line-height: 1.1; letter-spacing: -.04em; }
  .slides { display: grid; gap: 2rem; }
  .pair { display: grid; grid-template-columns: minmax(0,1fr) 2.5rem minmax(0,1fr); gap: 1.5rem; align-items: stretch; }

  .slides { grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; position: relative; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
  .slides::-webkit-scrollbar { display: none; }
  .pair { min-width: 0; scroll-snap-align: start; }
  .slides:focus-visible { outline: 3px solid #1f5b49; outline-offset: 3px; }
  .card { min-width: 0; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid #dedfd7; border-radius: .75rem; background: #fff; }
  .problem .label { color: #854136; }
  h3 { margin: 0 0 1.4rem; padding-bottom: 1.4rem; border-bottom: 1px solid #dedfd7; font-size: clamp(1.5rem, 2.3vw, 2.25rem); line-height: 1.15; letter-spacing: -.03em; }
  .solution h3 { color: #1f5b49; }
  .card > p:not(.label) { margin: 0 0 1rem; font-size: 1.05rem; line-height: 1.65; }
  .card > p:last-child { margin-bottom: 0; }
  .arrow { align-self: center; color: #1f5b49; font-size: 2.5rem; }

  .summary { max-width: 1000px; margin: 2rem auto; text-align: center; font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 700; line-height: 1.45; color: #1f5b49; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: 1rem; }
  .demo { background: #1f5b49; border-color: #1f5b49; color: white; }
  .trial { background: #f6e8c8; border-color: #f6e8c8; color: #1b2420; }
  .trial-wrap { display: grid; gap: .5rem; text-align: center; }
  small { font-size: .8rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 700px) { .pair { grid-template-columns: 1fr; gap: 1rem; } .arrow { justify-self: center; transform: rotate(90deg); } }
  @media (max-width: 480px) { .actions > *, .actions .button { width: 100%; } }
</style>
