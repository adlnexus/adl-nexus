---
import { routeFor } from '../data/localization';
interface Props { lang: 'en' | 'sr' | 'es' }
const { lang } = Astro.props; const sr = lang === 'sr'; const es = lang === 'es';
const links = [[es?'Resumen':sr?'Pregled':'Overview','/solutions/pipedrive'],[es?'Precios (en inglés)':sr?'Cene':'Pricing','/solutions/pipedrive/pricing'],[es?'Recursos (en inglés)':sr?'Baza znanja':'Knowledge base','/solutions/pipedrive/knowledge-base'],[es?'Implementación y formación (en inglés)':sr?'Implementacija i obuka':'Implementation & training','/solutions/pipedrive/implementation']];
const destination = (path: string) => routeFor(es && path !== '/solutions/pipedrive' ? 'en' : lang, path);
---
<nav class="product-nav" aria-label={es?'Páginas de Pipedrive':sr?'Pipedrive stranice':'Pipedrive pages'}>{links.map(([label,path])=><a href={destination(path)} hreflang={es && path !== '/solutions/pipedrive' ? 'en' : undefined} aria-current={Astro.url.pathname===destination(path)?'page':undefined}>{label}</a>)}<a href="/solutions/pipedrive/workshop/" hreflang="en" aria-current={Astro.url.pathname==='/solutions/pipedrive/workshop/'?'page':undefined}>{es?'Taller (en inglés)':sr?'Radionica EN':'Workshop'}</a></nav>
<style>.product-nav {display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem 1.5rem;margin:2rem auto 0;padding:1rem;color:#1f5b49;--focus-color:#1f5b49;}.product-nav a {font-size:.9rem;font-weight:700;text-decoration:underline;text-underline-offset:.25em;}.product-nav a[aria-current]{text-decoration-thickness:3px;}</style>
