---
import BrandLogo from './BrandLogo.astro';
import { routeFor, equivalentLocaleRoute, type SiteLocale } from '../data/localization';
interface Props { lang: SiteLocale }
const { lang } = Astro.props;
const copy = {
 en: { home:'Home ADL Nexus',overview:'Pipedrive Home',workshop:'Workshop',implementation:'Implementation',pricing:'Pricing',resources:'Knowledge base',contact:'Contact',menu:'Menu',language:'Language',nav:'Pipedrive navigation',en:'' },
 sr: { home:'Početna ADL Nexus',overview:'Pipedrive početna',workshop:'Radionica',implementation:'Implementacija',pricing:'Cene',resources:'Baza znanja',contact:'Kontakt',menu:'Meni',language:'Jezik',nav:'Pipedrive navigacija',en:' (EN)' },
 es: { home:'Inicio ADL Nexus',overview:'Inicio Pipedrive',workshop:'Taller',implementation:'Implementación',pricing:'Precios',resources:'Recursos',contact:'Contacto',menu:'Menú',language:'Idioma',nav:'Navegación de Pipedrive',en:' (en inglés)' },
}[lang];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const landing = routeFor(lang, '/solutions/pipedrive');
const local = lang === 'es' ? 'en' : lang;
const links = [
 { label:copy.home,href:routeFor(lang,'/'),language:lang },
 ...(path !== landing ? [{label:copy.overview,href:landing,language:lang}] : []),
 { label:copy.workshop+copy.en,href:'/solutions/pipedrive/workshop/',language:'en' },
 ...([['implementation',copy.implementation],['pricing',copy.pricing],['knowledge-base',copy.resources]] as const).map(([slug,label])=>({label:label+(lang==='es'?copy.en:''),href:routeFor(local,`/solutions/pipedrive/${slug}`),language:local})),
];
const englishOnly = /^\/solutions\/pipedrive\/(?:knowledge-base\/[^/]+|workshop)\/$/.test(path);
const languages: SiteLocale[] = englishOnly ? ['en'] : path===landing ? ['en','sr','es'] : ['en','sr'];
const contact = `${routeFor(lang,'/contact')}?solution=pipedrive#start-a-conversation`;
---
<header class="pd-header">
 <div class="pd-header-inner">
  <a class="brand" href={routeFor(lang,'/')} aria-label="ADL Nexus"><BrandLogo variant="green" /></a>
  <nav class="desktop" aria-label={copy.nav}>{links.map(link=><a href={link.href} hreflang={link.language} aria-current={path===link.href?'page':undefined}>{link.label}</a>)}</nav>
  <div class="actions">
   <a class="contact" href={contact}>{copy.contact}</a>
   {languages.length>1 && <details class="languages"><summary aria-label={copy.language}>{lang.toUpperCase()} <span aria-hidden="true">⌄</span></summary><div>{languages.map(locale=><a href={equivalentLocaleRoute(path,locale)} hreflang={locale} lang={locale} aria-current={lang===locale?'true':undefined}>{({en:'English',sr:'Srpski',es:'Español'})[locale]}</a>)}</div></details>}
   <details class="mobile"><summary>{copy.menu} <span aria-hidden="true">☰</span></summary><nav aria-label={copy.nav}>{links.map(link=><a href={link.href} hreflang={link.language} aria-current={path===link.href?'page':undefined}>{link.label}</a>)}</nav></details>
  </div>
 </div>
</header>
<script>
 document.querySelectorAll<HTMLDetailsElement>('.pd-header details').forEach(menu=>{
  menu.addEventListener('toggle',()=>{if(menu.open)document.querySelectorAll<HTMLDetailsElement>('.pd-header details').forEach(other=>{if(other!==menu)other.open=false;});});
  menu.addEventListener('keydown',event=>{if(event.key==='Escape'){menu.open=false;menu.querySelector('summary')?.focus();}});
  menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
 });
</script>
<style>
.pd-header{position:sticky;top:0;z-index:50;background:#faf8f1;color:#172c25;--focus-color:#1f5b49;border-bottom:1px solid #1f5b4910;}
.pd-header-inner{max-width:1600px;padding:12px 4%;margin:auto;display:flex;align-items:center;gap:clamp(1rem,2vw,2rem);min-height:76px;}
.brand{margin-right:auto;flex-shrink:0;}.brand :global(img){display:block;width:74px;height:auto;}
.desktop,.actions{display:flex;align-items:center;gap:clamp(.8rem,1.8vw,1.8rem);}.desktop a{font-size:clamp(.8rem,1.1vw,1.05rem);white-space:nowrap;padding:12px 0;}.desktop a:hover,.desktop a[aria-current],nav a:hover{text-decoration:underline;text-underline-offset:6px;}
.contact{background:#1f5b49;color:#fff;border-radius:14px;padding:16px 28px;font-weight:750;text-align:center;}.contact:hover{background:#163f34;}
summary{cursor:pointer;list-style:none;min-height:44px;display:flex;align-items:center;gap:.4rem;font-size:.8rem;font-weight:700;}summary::-webkit-details-marker{display:none;}.languages{position:relative;}.languages div{position:absolute;right:0;top:100%;padding:8px;background:#faf8f1;box-shadow:0 8px 24px #163f3422;border-radius:8px;min-width:130px;}.languages a{display:block;padding:12px;}.languages a[aria-current]{font-weight:800;text-decoration:underline;}.mobile{display:none;}
@media(max-width:1180px){.desktop{display:none;}.mobile{display:block;}.mobile nav{position:absolute;top:100%;left:0;right:0;background:#faf8f1;padding:16px 5%;box-shadow:0 12px 20px #163f3420;max-height:75svh;overflow:auto;}.mobile nav a{display:block;padding:13px 0;}.pd-header-inner{min-height:76px;}.contact{padding:12px 18px;}.actions{gap:14px;}}
@media(max-width:480px){.brand :global(img){width:64px;}.pd-header-inner{gap:10px;padding:10px 5%;}.actions{gap:10px;}.contact{padding:12px;font-size:.85rem;border-radius:10px;}.mobile summary{font-size:.75rem;}}
</style>
