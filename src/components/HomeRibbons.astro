---
// Geometry changes only with layout; scrolling updates the colour reveal only.
const colours = [
  ['#FFD56B', '#FFCA45'], ['#FF9C58', '#FF8A3D'],
  ['#F47C68', '#F16858'], ['#AAAAAA', '#969696'],
];
---
<div class="home-ribbons" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" focusable="false" fill="none">
    <defs>
      {colours.map(([light, colour], index) => <linearGradient id={`home-ribbon-${index}`} x1="0" y1="0" x2="1" y2="1">
        <stop stop-color={light} /><stop offset=".55" stop-color={colour} /><stop offset="1" stop-color={light} />
      </linearGradient>)}
      <linearGradient id="home-ribbon-progress" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="white" />
        <stop data-reveal-start offset="0" stop-color="white" />
        <stop data-reveal-end offset="0" stop-color="white" stop-opacity=".14" />
        <stop data-reveal-tail offset="1" stop-color="white" stop-opacity=".14" />
      </linearGradient>
      <mask id="home-ribbon-mask" maskUnits="userSpaceOnUse" style="mask-type: luminance">
        <rect width="100%" height="100%" fill="url(#home-ribbon-progress)" />
      </mask>
    </defs>
    <g mask="url(#home-ribbon-mask)">
      {colours.map((_, index) => <path data-ribbon={index} fill={`url(#home-ribbon-${index})`} />)}
    </g>
  </svg>
</div>

<style>
  .home-ribbons { position: absolute; inset: 0; z-index: 1; overflow: clip; pointer-events: none; visibility: hidden; }
  .home-ribbons svg { display: block; width: 100%; height: 100%; }
  :global(body.home-ribbon-page) { position: relative; isolation: isolate; }
  :global(.home-ribbons-ready) .home-ribbons { visibility: visible; }
  :global(.home-ribbons-ready .home-hero .hero-bands) { visibility: hidden; }
  /* Section backgrounds stay below the ribbon; actual content stays above it. */
  :global(body.home-ribbons-ready .homepage-content) { isolation: auto; }
  :global(body.home-ribbons-ready .homepage-content::before) { z-index: 0; }
  :global(.home-ribbons-ready .homepage-content .container) { position: relative; z-index: 2; }
  /* Keep the continuous path beneath a translucent footer surface. */
  :global(.home-ribbons-ready .footer--home) { position: relative; }
  :global(.home-ribbons-ready .footer--home::before) { content: ''; position: absolute; inset: 0; z-index: 2; background: rgba(23, 25, 28, .82); pointer-events: none; }
  :global(.home-ribbons-ready .footer--home .container) { position: relative; z-index: 3; }
  /* A light, feathered surface lets the ribbons recede behind Why ADL. */
  :global(.home-ribbons-ready .home-why) { position: relative; }
  :global(.home-ribbons-ready .home-why::before) { content: ''; position: absolute; inset: 0; z-index: 2; background: linear-gradient(to bottom, rgba(255, 253, 251, 0), rgba(255, 253, 251, .82) 16%, rgba(255, 253, 251, .82) 84%, rgba(255, 253, 251, 0)); pointer-events: none; }
  :global(.home-ribbons-ready .homepage-content .home-why .container) { z-index: 3; }
  /* A fine surface-coloured text halo keeps the bright path continuous,
     without large panels cutting through it or changing content dimensions. */
  :global(.home-ribbons-ready :is(.home-hero-copy > .eyebrow, .home-hero-copy > h1, .home-hero-lead, .home-audiences .eyebrow, .home-why, .solutions-head, .closing-heading, .closing-action p, .footer-grid, .footer-bottom)) { text-shadow: 0 0 2px var(--ribbon-copy-surface, var(--paper)), 0 0 5px var(--ribbon-copy-surface, var(--paper)); }
  :global(body.home-ribbon-page.home-ribbons-ready :is(.home-hero-lead, .home-why-grid p, .solutions-head > p)) { color: var(--ink); }
  :global(.home-ribbons-ready :is(.closing--home, .footer--home)) { --ribbon-copy-surface: #17191c; }
</style>

<script>
  const layer = document.querySelector<HTMLElement>('.home-ribbons');
  if (layer) {
    const svg = layer.querySelector('svg')!;
    const paths = [...svg.querySelectorAll<SVGPathElement>('[data-ribbon]')];
    const revealStart = svg.querySelector('[data-reveal-start]')!;
    const revealEnd = svg.querySelector('[data-reveal-end]')!;
    const revealTail = svg.querySelector('[data-reveal-tail]')!;
    const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
    let pageHeight = 1;
    const updateProgress = () => {
      const atBottom = window.scrollY + window.innerHeight >= pageHeight - 2;
      // Follow the current position in both directions, without retaining a
      // high-water mark. No parallax or moving geometry.
      // Centre the soft colour transition in the viewport.
      const blendHeight = Math.max(180, Math.min(300, window.innerHeight * .3));
      const revealed = atBottom ? 1 : Math.max(0, Math.min(1, (window.scrollY + window.innerHeight * .5 - blendHeight / 2) / pageHeight));
      const progress = motionPreference.matches ? 1 : revealed;
      revealStart.setAttribute('offset', String(progress));
      // A wider, viewport-scaled blend avoids a hard colour boundary.
      revealEnd.setAttribute('offset', String(Math.min(1, progress + blendHeight / pageHeight)));
      revealEnd.setAttribute('stop-opacity', progress === 1 ? '1' : '.14');
      revealTail.setAttribute('stop-opacity', progress === 1 ? '1' : '.14');
    };
    const hero = document.querySelector<HTMLElement>('.home-hero')!;
    const bands = hero.querySelector<HTMLElement>('.hero-bands')!;
    const audience = document.querySelector<HTMLElement>('.home-audiences')!;
    const why = document.querySelector<HTMLElement>('.home-why')!;
    const solutions = document.querySelector<HTMLElement>('.solutions--cards')!;
    const closing = document.querySelector<HTMLElement>('.closing--home')!;
    const footer = document.querySelector<HTMLElement>('.footer--home')!;
    type Point = { x: number; y: number; width: number; pitch: number };

    const miter = (points: Point[], index: number) => {
      const normal = (a: Point, b: Point) => {
        const length = Math.hypot(b.x - a.x, b.y - a.y);
        return { x: (b.y - a.y) / length, y: -(b.x - a.x) / length };
      };
      const before = normal(points[Math.max(0, index - 1)], points[index === 0 ? 1 : index]);
      const after = normal(points[index === points.length - 1 ? index - 1 : index], points[Math.min(points.length - 1, index + 1)]);
      const divisor = Math.max(.4, 1 + before.x * after.x + before.y * after.y);
      return { x: (before.x + after.x) / divisor, y: (before.y + after.y) / divisor };
    };

    // Offset both edges of each stripe along the shared centreline. Mitered
    // corners keep all four stripes parallel, including at left/right turns.
    const outline = (points: Point[], stripe: number) => {
      const edge = (side: number) => points.map((point, index) => {
        const corner = miter(points, index);
        const distance = (stripe - 1.5) * point.pitch + side * point.width / 2;
        return `${(point.x + corner.x * distance).toFixed(2)},${(point.y + corner.y * distance).toFixed(2)}`;
      });
      return `M${edge(-1).join('L')}L${edge(1).reverse().join('L')}Z`;
    };

    const draw = () => {
      const bodyRect = document.body.getBoundingClientRect();
      const width = bodyRect.width;
      const height = document.body.offsetHeight;
      pageHeight = height;
      const mobile = width <= 900;
      const top = (element: HTMLElement) => element.getBoundingClientRect().top - bodyRect.top;
      const heroHeight = hero.offsetHeight;
      // Match the existing SVG's cover scaling and header-aligned upper bands.
      const scale = Math.max(width / 800, heroHeight / 900);
      const transform = getComputedStyle(bands).transform;
      const shift = transform === 'none' ? 0 : new DOMMatrixReadOnly(transform).m41;
      const upperX = 536 * scale + (width - 800 * scale) * .58 + shift;
      const bendY = 389.5 * scale + (heroHeight - 900 * scale) / 2;
      const slim = mobile ? Math.max(10, Math.min(16, width * .034)) : Math.min(22, width * .016);
      const pitch = slim * 1.3;
      const margin = mobile ? slim * 4 : Math.max(90, width * .075);
      const point = (x: number, y: number, ribbonWidth = slim, ribbonPitch = pitch): Point => ({ x, y, width: ribbonWidth, pitch: ribbonPitch });
      const points = [
        point(upperX, -120, 48 * scale, 60 * scale),
        point(upperX, bendY, 48 * scale, 60 * scale),
        point(margin, heroHeight + Math.min(50, audience.offsetHeight * .1), slim * 1.5, pitch * 1.5),
        point(width - margin, top(why) - 30),
        point(margin, top(solutions) + 45),
        point(width - margin, top(closing) - 35),
        point(width * .2, top(footer) + footer.offsetHeight * .28),
        point(width * .12, height + 100),
      ];
      if (!mobile) {
        const content = audience.querySelector<HTMLElement>('.container')!.getBoundingClientRect();
        const left = content.left - bodyRect.left + 1;
        const right = content.right - bodyRect.left - 1;
        // Fit the OUTER stripe corners, not just the centreline. Re-evaluate
        // after moving turns because their miter angles change as well.
        // This moves complete bends inward instead of clipping their tips.
        for (let pass = 0; pass < 24; pass++) {
          let movement = 0;
          points.forEach((point, index) => {
            const extent = Math.abs(miter(points, index).x) * (1.5 * point.pitch + point.width / 2);
            if (extent > (right - left) / 2) {
              const fit = (right - left) / (2 * extent);
              point.width *= fit;
              point.pitch *= fit;
            }
            const inset = Math.min(extent, (right - left) / 2);
            const x = Math.max(left + inset, Math.min(right - inset, point.x));
            movement = Math.max(movement, Math.abs(x - point.x));
            point.x = x;
          });
          if (movement < .01) break;
        }
      }
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      paths.forEach((path, index) => path.setAttribute('d', outline(points, index)));
      updateProgress();
      document.body.classList.add('home-ribbons-ready');
    };

    let scheduled = false;
    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { scheduled = false; draw(); });
    };
    const observer = new ResizeObserver(schedule);
    [document.body, hero, audience, why, solutions, closing, footer].forEach(element => observer.observe(element));
    document.fonts.ready.then(schedule);
    let progressScheduled = false;
    window.addEventListener('scroll', () => {
      if (progressScheduled || motionPreference.matches) return;
      progressScheduled = true;
      requestAnimationFrame(() => { progressScheduled = false; updateProgress(); });
    }, { passive: true });
    motionPreference.addEventListener('change', updateProgress);
    draw();
  }
</script>
