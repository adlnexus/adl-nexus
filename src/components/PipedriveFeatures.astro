---
import type { PipedriveDetailedCopy } from '../data/pipedrive';
interface Props { lang: 'en' | 'sr'; copy: PipedriveDetailedCopy['features']; demoHref: string; demoLabel: string }
const { lang, copy, demoHref, demoLabel } = Astro.props;
const sr = lang === 'sr';
---
<section id="pipedrive-features" class="features" data-features aria-labelledby="features-title">
  <div class="container">
    <header><p class="eyebrow">{copy.eyebrow}</p><h2 id="features-title">{copy.title}</h2></header>
    <ul class="track" id="feature-track" tabindex="0" aria-label={sr ? 'Funkcionalnosti — koristite strelice za listanje' : 'Features — use arrow keys to browse'}>
      {copy.items.map(item => <li><article><h3>{item.title}</h3><p>{item.text}</p></article></li>)}
    </ul>
    <div class="controls" data-controls hidden>
      <button type="button" data-prev aria-controls="feature-track" aria-label={sr ? 'Prethodna funkcionalnost' : 'Previous feature'}>←</button>
      <span data-status aria-live="polite" aria-atomic="true"></span>
      <button type="button" data-next aria-controls="feature-track" aria-label={sr ? 'Sledeća funkcionalnost' : 'Next feature'}>→</button>
    </div>
    <div class="actions"><a class="button" href={demoHref}>{demoLabel}</a></div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-features]').forEach(root => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const cards = [...track.querySelectorAll<HTMLElement>('li')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let target = 0;
    const stride = () => cards[1].offsetLeft - cards[0].offsetLeft;
    const max = () => Math.max(0, track.scrollWidth - track.clientWidth);
    const update = () => {
      const first = Math.round(track.scrollLeft / stride());
      const visible = Math.max(1, Math.floor((track.clientWidth + stride() - cards[0].offsetWidth + 1) / stride()));
      const last = Math.min(cards.length, first + visible);
      status.textContent = `${first + 1}${last > first + 1 ? `–${last}` : ''} / ${cards.length}`;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max() - 1;
    };
    const go = (index: number, instant = false) => {
      target = Math.max(0, Math.min(Math.ceil(max() / stride()), index));
      track.scrollTo({ left: Math.min(max(), target * stride()), behavior: instant || motion.matches ? 'instant' : 'smooth' });
    };
    prev.addEventListener('click', () => go(target - 1));
    next.addEventListener('click', () => go(target + 1));
    track.addEventListener('keydown', event => {
      const keys: Record<string, number> = { ArrowLeft: target - 1, ArrowRight: target + 1, Home: 0, End: cards.length - 1 };
      if (!(event.key in keys)) return;
      event.preventDefault(); go(keys[event.key]);
    });
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('scrollend', () => { target = Math.round(track.scrollLeft / stride()); update(); });
    new ResizeObserver(() => { go(target, true); update(); }).observe(track);
    motion.addEventListener('change', () => { go(target, true); update(); });
    root.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
    update();
  });
</script>
<style>
  .features { padding: clamp(3.5rem, 6vw, 6rem) 0; background: #faf8f1; color: #262626; scroll-margin-top: 7rem; --focus-color: #1f5b49; }
  header { max-width: 1000px; margin: 0 auto 2.5rem; text-align: center; }
  .eyebrow { margin: 0 0 1rem; color: #1f5b49; font-weight: 750; }
  h2 { margin: 0; color: #1f5b49; font-size: clamp(2rem, 3.5vw, 3.5rem); line-height: 1.12; letter-spacing: -.04em; }
  /* One intrinsic grid row takes the height of the longest of all 12 cards. */
  .track { position: relative; display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 2rem) / 3); gap: 1rem; margin: 0; padding: .25rem 0 .75rem; list-style: none; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; }
  .track:focus-visible { outline: 3px solid #1f5b49; outline-offset: 3px; }
  li { min-width: 0; scroll-snap-align: start; }
  article { height: 100%; padding: clamp(1.5rem, 2.5vw, 2.5rem); border: 1px solid #dedbd0; border-radius: .75rem; background: #fffdf8; }
  h3 { margin: 0 0 1.75rem; color: #1f5b49; font-size: clamp(1.35rem, 1.8vw, 1.8rem); line-height: 1.2; letter-spacing: -.03em; overflow-wrap: anywhere; }
  article p { margin: 0; font-size: 1.05rem; line-height: 1.65; }
  .controls { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-top: 1rem; }
  .controls[hidden] { display: none; }
  button { width: 48px; height: 48px; border: 1px solid #1f5b49; border-radius: 50%; background: white; color: #1f5b49; font-size: 1.5rem; cursor: pointer; }
  button:hover:not(:disabled) { background: #1f5b49; color: white; }
  button:disabled { opacity: .4; cursor: default; }
  [data-status] { min-width: 7ch; text-align: center; font-variant-numeric: tabular-nums; }
  .actions { margin-top: 2rem; text-align: center; }
  .button { background: #1f5b49; border-color: #1f5b49; color: white; min-width: min(100%, 320px); }
  .button:hover, .button:focus-visible { background: #173f34; border-color: #173f34; }
  @media (max-width: 1000px) { .track { grid-auto-columns: calc((100% - 1rem) / 2); } }
  @media (max-width: 600px) { .track { grid-auto-columns: 88%; } }
</style>
