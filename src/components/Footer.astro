---
import BrandLogo from './BrandLogo.astro';
import { routeFor, uiCopy, type SiteLocale } from '../data/localization';
import { contactEmails } from '../data/contact';

interface Props { lang?: SiteLocale; variant?: 'default' | 'home' }
const { lang = 'en', variant = 'default' } = Astro.props;
const ui = uiCopy[lang];
const href = (route: string) => routeFor(lang, route);
---
<footer class:list={['footer', { 'footer--home': variant === 'home' }]}>
  <div class="footer-grid container">
    <div class="footer-brand"><BrandLogo class="footer-logo" variant="tagline-white" alt="ADL Nexus — Global Connections" /><p>{ui.footer.tagline}</p></div>
    <div><h2>{ui.footer.explore}</h2><a href={href('/services')}>{ui.nav.services}</a><a href={href('/solutions/pipedrive')}>Pipedrive</a><a href={href('/solutions/learnie')}>Learnie</a></div>
    <div><h2>{ui.footer.contact}</h2>{contactEmails.map((email) => <a href={`mailto:${email}`}>{email}</a>)}</div>
  </div>
  <div class="footer-bottom container"><span class="footer-legal"><span>© {new Date().getFullYear()} ADL Nexus</span><span class="footer-divider" aria-hidden="true"></span><a href={href('/privacy-policy')}>{ui.footer.privacy}</a></span><span>{ui.footer.closing}</span></div>
</footer>

<style>
  .footer { --focus-color: var(--accent-on-dark); padding: 5rem 0 2rem; background: var(--ink); color: var(--white); }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1.4fr; gap: 3rem; }
  .footer-grid > div { display: flex; flex-direction: column; align-items: flex-start; gap: .72rem; }
  /* The tagline SVG has ~14% built-in side padding; shift it so the mark lines up with the text below. */
  :global(.footer-logo) { width: 152px; height: auto; transform: translateX(-14.1%); }
  .footer h2 { margin: 0 0 .6rem; color: #888; font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; }
  .footer a, .footer p { margin: 0; color: #bdbdc2; font-size: .84rem; line-height: 1.5; }
  .footer a:hover { color: var(--white); }
  .footer-brand p { max-width: 260px; margin-top: 1rem; }
  .footer-bottom { display: flex; justify-content: space-between; margin-top: 5rem; padding-top: 1.5rem; border-top: 1px solid #28282b; color: #888; font-size: .7rem; }
  .footer-legal { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .footer-divider { width: 1px; height: 1em; background: currentColor; }
  .footer .footer-legal a { color: inherit; font-size: inherit; }
  .footer .footer-legal a:hover { color: var(--white); }
  .footer--home { padding: 2.75rem 0 1.5rem; border-top: 1px solid rgba(255,255,255,.1); background: #17191c; }
  .footer--home .footer-grid { grid-template-columns: 1.4fr .8fr 1.4fr; gap: 2rem; }
  .footer--home .footer-grid > div { min-width: 0; gap: .5rem; }
  .footer--home :global(.footer-logo) { width: 104px; }
  .footer--home .footer-brand p { max-width: 235px; margin-top: .5rem; }
  .footer--home a { overflow-wrap: anywhere; }
  .footer--home .footer-bottom { margin-top: 2rem; padding-top: 1rem; }
  @media (max-width: 800px) { .footer--home .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .footer--home .footer-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 800px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } .footer-bottom { flex-direction: column; gap: .7rem; } }
</style>
