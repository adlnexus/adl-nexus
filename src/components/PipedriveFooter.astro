---
import BrandLogo from './BrandLogo.astro';
import { contactEmails } from '../data/contact';
interface Props { lang?: 'en' | 'sr' | 'es' }
const { lang = 'en' } = Astro.props; const sr = lang === 'sr';
---
<footer class="pipedrive-footer">
 <div class="container columns"><div><div class="logo-wrap"><BrandLogo variant="tagline-white" /></div><p>{sr ? 'Kao zvanični Pipedrive Premier Partner u PartnerScaleHub distributivnoj mreži, gradimo prodajne CRM sisteme na Pipedrive platformi, prilagođene prodajnom procesu vaše kompanije.' : 'As an official Pipedrive Premier Partner in the PartnerScaleHub distribution network, we build custom sales CRM systems on the Pipedrive platform, tailored to your company’s sales process.'}</p></div><div><h2>{sr ? 'Lokacija' : 'Location'}</h2><p>{sr ? 'Beograd · radimo međunarodno' : 'Belgrade · working internationally'}</p></div><div><h2>{sr ? 'Kontakt' : 'Contact'}</h2><a href={`mailto:${contactEmails[0]}`}>{contactEmails[0]}</a></div></div>
 <div class="container copyright">© 2026 ADL Nexus. {sr ? 'Sva prava zadržana.' : 'All rights reserved.'}</div>
</footer>
<style>
.pipedrive-footer { background:#1f5b49;color:white;padding:3.5rem 0 1.5rem;--focus-color:#f6e8c8; }.columns { display:grid;grid-template-columns:2fr 1fr 1fr;gap:3rem; }.columns>div { min-width:0; }.pipedrive-footer .logo-wrap { width:180px;max-width:100%; }.pipedrive-footer .logo-wrap :global(img) { display:block;width:100%;height:auto; }.columns p { line-height:1.65;font-size:.95rem; }.columns h2 { font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;margin:0 0 1rem; }.columns a { color:white;overflow-wrap:anywhere; }.copyright { border-top:1px solid #ffffff50;margin-top:2rem;padding-top:1rem;font-size:.85rem; }@media(max-width:800px) {.columns{grid-template-columns:1fr;gap:1.5rem;}}
</style>
