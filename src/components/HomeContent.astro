---
import FeaturedSolutions from './FeaturedSolutions.astro';
import ClosingCta from './ClosingCta.astro';
import { homeCopy } from '../data/home';
import { routeFor, type SiteLocale } from '../data/localization';
interface Props { lang?: SiteLocale }
const { lang = 'en' } = Astro.props;
const copy = homeCopy[lang];
---
<div class="homepage-content">
  <section class="home-section home-audiences">
    <div class="container">
      <p class="eyebrow">{copy.audienceLabel}</p>
      <div class="home-audience-grid">
        {copy.audiences.map((audience, index) => <article class="home-audience">
          <h2>{audience.title}</h2><p>{audience.text}</p>
          <a class="button" href={index === 0 ? '#solutions' : routeFor(lang, '/services')}>{audience.action}</a>
        </article>)}
      </div>
    </div>
  </section>
  <section class="home-section home-why">
    <div class="container">
      <div class="home-why-heading"><p class="eyebrow">{copy.why.eyebrow}</p><h2 class="home-section-title">{copy.why.title}</h2></div>
      <div class="home-why-grid">
        {copy.why.points.map(point => <article><h3>{point.title}</h3><p>{point.text}</p></article>)}
      </div>
    </div>
  </section>
  <FeaturedSolutions lang={lang} />
</div>
<ClosingCta lang={lang} variant="home" eyebrow={copy.closing.eyebrow} title={copy.closing.title} accent={copy.closing.accent} text={copy.closing.text} buttonLabel={copy.closing.cta} />
<style>
  .homepage-content { position: relative; isolation: isolate; background: var(--paper); }
  .homepage-content::before { position: absolute; z-index: -1; inset: 0; background: url('/brand/adl-nexus-home-flow.svg') center / 100% 100% no-repeat; pointer-events: none; content: ''; }
  .home-section { padding: clamp(3.5rem, 6vw, 5.5rem) 0; }
  .home-audience-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2rem; }
  .home-audience { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid rgba(255,255,255,.9); border-radius: 18px; background: rgba(255,255,255,.95); box-shadow: 0 10px 35px rgba(93,57,40,.045); }
  .home-audience h2 { margin: 0 0 1rem; font-size: clamp(1.6rem, 2.2vw, 2.1rem); letter-spacing: -.045em; line-height: 1.08; }
  .home-audience p { margin: 0 0 2rem; color: var(--muted); line-height: 1.6; }
  .home-audience .button { margin-top: auto; border-color: var(--accent-line); color: var(--accent-dark); }
  .home-audience .button:hover, .home-audience .button:focus-visible { background: var(--accent-dark); color: white; }
  .home-section-title { max-width: 20ch; margin: 0; font-size: clamp(2rem, 3.5vw, 3.2rem); letter-spacing: -.055em; line-height: 1.02; }
  .home-why .container { min-height: 680px; }
  .home-why-heading { max-width: 60%; }
  .home-why-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(3, auto); column-gap: 2.5rem; margin-top: 4rem; }
  .home-why-grid article { min-width: 0; padding: 1rem; }
  .home-why-grid article:nth-child(1) { grid-area: 3 / 1; }
  .home-why-grid article:nth-child(2) { grid-area: 2 / 2; }
  .home-why-grid article:nth-child(3) { grid-area: 1 / 3; }
  .home-why-grid h3 { margin: 0 0 .8rem; font-size: 1.3rem; letter-spacing: -.035em; }
  .home-why-grid p { margin: 0; color: var(--muted); line-height: 1.6; }
  @media (max-width: 900px) {
    .home-audience-grid, .home-why-grid { grid-template-columns: minmax(0, 1fr); }
    .home-why .container { min-height: 0; }
    .home-why-heading { max-width: none; }
    .home-why-grid { gap: 1.5rem; margin-top: 2rem; }
    .home-why-grid article:nth-child(n) { grid-area: auto; padding: 1.25rem; }
  }
</style>
