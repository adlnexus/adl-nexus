---
import FeaturedSolutions from './FeaturedSolutions.astro';
import ClosingCta from './ClosingCta.astro';
import HomeIcon from './HomeIcon.astro';
import { landingCopy, type SiteLocale } from '../data/localization';

interface Props { lang?: SiteLocale }
interface Audience {
  label: string;
  title: string;
  paragraphs: string[];
  principle?: string;
  actions?: { label: string; href: string; secondary?: boolean }[];
}
interface HomeCopy {
  audienceLabel: string;
  audiences: Audience[];
  why: { eyebrow: string; title: string; points: { number?: string; title?: string; text: string }[] };
  closing: { eyebrow: string; title: string; text?: string; cta: string };
}
const { lang = 'en' } = Astro.props;
const english: HomeCopy = {
  audienceLabel: 'Two sides of one partnership',
  audiences: [
    {
      label: '01 / Organisations', title: 'Find software that fits.',
      paragraphs: ['We carefully select one strong solution for each organisational need, rather than offering a catalogue of competing products. Our portfolio is deliberately selective. We partner only with solutions we believe in.'],
      actions: [{ label: 'Let’s chat', href: '/contact/#start-a-conversation' }],
    },
    {
      label: '02 / Tech companies', title: 'Grow in the right markets.',
      paragraphs: ['Business development, sales representation and support backed by extensive market experience and a strong international network.'],
      principle: 'We work as a dedicated extension of your team and do not represent competing solutions that address the same need.',
      actions: [{ label: 'Explore our services', href: '/services/' }, { label: 'Let’s chat', href: '/contact/?solution=market-entry#start-a-conversation', secondary: true }],
    },
  ],
  why: {
    eyebrow: 'Why ADL?', title: 'Selective by design. Committed by nature.',
    points: [
      { number: '01', title: 'We choose carefully.', text: 'We partner only with solutions we believe in and do not represent direct competitors.' },
      { number: '02', title: 'We know the markets.', text: 'Our approach is grounded in extensive international sales experience and a strong professional network.' },
      { number: '03', title: 'We think long term.', text: 'We build transparent, long-term relationships with tech companies and the organisations they serve.' },
    ],
  },
  closing: { eyebrow: 'Start a conversation', title: 'The right software. The right market. Let’s find it.', text: 'Tell us where you want to go. We’ll bring focus, clarity and a partnership built to last.', cta: 'Contact us' },
};
const localized = lang === 'en' ? undefined : landingCopy[lang];
const copy: HomeCopy = localized ? {
  audienceLabel: localized.audiences.eyebrow,
  audiences: [
    { label: localized.audiences.organisations, title: localized.audiences.organisationsTitle, paragraphs: [localized.audiences.organisationsText] },
    { label: localized.audiences.tech, title: localized.audiences.techTitle, paragraphs: [localized.audiences.techText] },
  ],
  why: { ...localized.why, points: localized.why.points.map((text) => ({ text })) },
  closing: localized.closing,
} : english;
const whyIcons = ['search', 'people', 'partnership'] as const;
const closingAccent = copy.closing.title.slice(copy.closing.title.lastIndexOf('. ') + 2);
---

<div class="homepage-content">
  <section class="home-section home-audiences" id={localized ? 'about' : undefined}>
    <div class="container">
      <p class="eyebrow">{copy.audienceLabel}</p>
      <div class="home-audience-grid">
        {copy.audiences.map((audience, index) => (
          <article class="home-audience">
            <div class:list={['home-icon', { 'home-icon--green': index === 1 }]}><HomeIcon name={index === 0 ? 'organisation' : 'growth'} /></div>
            <div class="home-audience-copy">
              <span class="home-label">{audience.label}</span>
              <h2>{audience.title}</h2>
              {audience.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {audience.principle && <p class="home-principle">{audience.principle}</p>}
              {audience.actions && <div class="home-actions">{audience.actions.map((action) => <a class={action.secondary ? 'text-link' : 'button'} href={action.href}>{action.label}</a>)}</div>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section home-why" id={localized ? 'services' : undefined}>
    <div class="container">
      <p class="eyebrow">{copy.why.eyebrow}</p>
      <h2 class="home-section-title">{copy.why.title}</h2>
      <div class="home-why-grid">
        {copy.why.points.map((point, index) => (
          <article>
            <div class="home-why-mark">{point.number && <span>{point.number}</span>}<HomeIcon name={whyIcons[index]} /></div>
            {point.title && <h3>{point.title}</h3>}
            <p>{point.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FeaturedSolutions lang={lang} variant="cards" />
</div>
<ClosingCta lang={lang} variant="home" id={localized ? 'contact' : undefined} eyebrow={copy.closing.eyebrow} title={copy.closing.title} accent={closingAccent} text={copy.closing.text ?? ''} buttonLabel={copy.closing.cta} />

<style>
  .homepage-content { position: relative; isolation: isolate; background: var(--paper); }
  .homepage-content::before { position: absolute; z-index: -1; inset: 0; background: url('/brand/adl-nexus-home-flow.svg') center / 100% 100% no-repeat; pointer-events: none; content: ''; }
  .home-section { padding: clamp(3.5rem, 6vw, 5.5rem) 0; }
  .home-audiences { padding-bottom: clamp(2.5rem, 4vw, 4rem); }
  .home-audience-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2rem; }
  .home-audience { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid rgba(255,255,255,.9); border-radius: 18px; background: rgba(255,255,255,.93); box-shadow: 0 10px 35px rgba(93,57,40,.045); }
  .home-icon { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #be751d; background: #fff6e8; }
  .home-icon--green { color: #367e6a; background: #edf6f1; }
  .home-audience-copy { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .home-label { color: var(--accent); font-size: .7rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .home-audience h2 { margin: .75rem 0 1rem; font-size: clamp(1.6rem, 2.2vw, 2.1rem); letter-spacing: -.045em; line-height: 1.08; overflow-wrap: anywhere; }
  .home-audience p { margin: 0 0 1rem; color: var(--muted); line-height: 1.6; }
  .home-audience .home-principle { padding-left: 1rem; border-left: 2px solid var(--accent-line); font-size: .9rem; }
  .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: auto; padding-top: 1rem; }
  .home-actions .button { border-color: var(--accent-line); color: var(--accent-dark); }
  .home-actions .button:hover, .home-actions .button:focus-visible { border-color: var(--accent-dark); background: var(--accent-dark); color: var(--white); }
  .home-actions .text-link { color: var(--accent-dark); }
  .home-section-title { max-width: 23ch; margin: 0; font-size: clamp(2rem, 3.5vw, 3.2rem); letter-spacing: -.055em; line-height: 1.02; }
  .home-why-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-top: 3rem; }
  .home-why-grid article { min-width: 0; padding-right: 2rem; }
  .home-why-grid article + article { border-left: 1px solid var(--line); padding-left: 2rem; }
  .home-why-grid article:last-child { padding-right: 0; }
  .home-why-mark { display: flex; align-items: center; gap: 1.25rem; color: var(--accent); margin-bottom: 1.25rem; }
  .home-why-mark span { font-size: 1.05rem; font-weight: 700; }
  .home-why-grid h3 { margin: 0 0 .8rem; font-size: 1.3rem; letter-spacing: -.035em; }
  .home-why-grid p { margin: 0; color: var(--muted); line-height: 1.6; }
  @media (max-width: 900px) {
    .home-audience-grid, .home-why-grid { grid-template-columns: minmax(0, 1fr); }
    .home-why-grid { gap: 1.5rem; margin-top: 2rem; }
    .home-why-grid article, .home-why-grid article + article { border-left: 0; padding: 0; }
    .home-why-grid article + article { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  }
  @media (max-width: 480px) {
    .home-audience { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .home-actions { align-items: flex-start; flex-direction: column; }
  }
</style>
