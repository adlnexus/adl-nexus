---
import PipedriveCarouselControls from './PipedriveCarouselControls.astro';
import stories from '../data/pipedrive-stories.json';
interface Props { lang: 'en' | 'sr' | 'es'; compact?: boolean }
const { lang, compact = false } = Astro.props;
const entries = compact ? stories[lang].slice(3) : stories[lang]; const sr = lang === 'sr';
const ratings = [['Capterra','4.5'],['Gartner','4.3'],['GetApp','4.5'],['Software Advice','4.5'],['SourceForge','4.7']];
const es = lang === 'es';
---
<section class="stories" id="pipedrive-stories" data-stories data-pause={es ? 'Pausar' : sr ? 'Pauziraj' : 'Pause'} data-play={es ? 'Reanudar' : sr ? 'Pokreni' : 'Play'} aria-labelledby="stories-title">
 <div class="container">
  <header><p class="eyebrow">{es ? 'Experiencias de clientes de Pipedrive' : sr ? 'Iskustva Pipedrive korisnika' : 'Pipedrive customer stories'}</p><h2 id="stories-title">{es ? 'Resultados reales de empresas reales.' : sr ? 'Stvarni rezultati stvarnih kompanija.' : 'Real results from real businesses.'}</h2></header>
  <ul id="stories-track" class="track" tabindex="0" aria-label={es ? 'Experiencias de clientes: usa las flechas del teclado para desplazarte' : sr ? 'Iskustva korisnika — koristite strelice za listanje' : 'Customer stories — use arrow keys to browse'}>{entries.map(([category, quote, name, role, metrics]) => <li><article><p class="eyebrow">{category}</p>{Array.isArray(metrics) && metrics.length > 0 && <dl>{metrics.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}<blockquote><p>{quote}</p></blockquote><p class="person"><strong>{name}</strong><span>{role}</span></p></article></li>)}</ul>
  <PipedriveCarouselControls lang={lang} trackId="stories-track" centered={false} />
  <p class="trust">{es ? 'Más de 100.000 empresas en 179 países utilizan Pipedrive' : sr ? 'Više od 100.000 kompanija u 179 zemalja koristi Pipedrive' : 'Used by over 100,000 companies in 179 countries'}</p>
  <ul class="ratings" aria-label={es ? 'Valoraciones de los usuarios' : sr ? 'Ocene korisnika' : 'Customer ratings'}>{ratings.map(([name,score]) => <li><strong>{name}</strong><span>{score}/5</span><span class="stars" aria-hidden="true">★★★★★</span></li>)}</ul>
 </div>
</section>
<style>
.track{scrollbar-width:none;}

.track::-webkit-scrollbar{display:none;}
.stories { padding:clamp(3.5rem,6vw,6rem) 0; background:#faf8f1;color:#262626;--focus-color:#1f5b49;scroll-margin-top:7rem; }
header { text-align:center;margin-bottom:2.5rem; }.eyebrow { color:#1f5b49;font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;font-weight:750; }
h2 { margin:0;color:#1f5b49;font-size:clamp(2rem,3.5vw,3.5rem);letter-spacing:-.04em;line-height:1.12; }
.track { display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 2rem)/3);gap:1rem;position:relative;overflow-x:auto;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;list-style:none;margin:0;padding:.25rem 0 .75rem; }
.track:focus-visible { outline:3px solid #1f5b49;outline-offset:3px; }.track li { min-width:0;scroll-snap-align:start; }
article { display:flex;flex-direction:column;height:100%;padding:1.5rem;border:1px solid #dedbd0;border-radius:1rem;background:#fffdf8; }
dl { display:grid;grid-template-columns:1fr 1fr;border:1px solid #dedbd0;border-radius:.5rem;margin:0 0 1rem; }dl div { padding:.7rem; }dt { font-size:.75rem;line-height:1.4; }dd { margin:.4rem 0 0;font-size:1.6rem;font-weight:750;color:#1f5b49; }
blockquote { margin:0 0 1.5rem;line-height:1.65; }blockquote p { margin:0; }.person { margin:auto 0 0;display:grid;gap:.35rem;line-height:1.5; }.person span { font-size:.9rem;color:#555; }

.trust { text-align:center;font-weight:700;color:#1f5b49; }.ratings { display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;list-style:none;padding:1.5rem 0;margin:0; }.ratings li { display:grid;gap:.5rem;text-align:center; }.stars { color:#a65b00;letter-spacing:.15em; }
@media(max-width:1000px) { .track { grid-auto-columns:calc((100% - 1rem)/2); } }
@media(max-width:650px) { .track { grid-auto-columns:92%; }.ratings { grid-template-columns:repeat(2,1fr); } }
</style>
