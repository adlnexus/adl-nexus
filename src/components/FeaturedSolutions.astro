---
import { localizedPagesCopy } from '../data/localized-pages';
import { routeFor, type LocalizedLandingCode, type SiteLocale } from '../data/localization';

interface Props { lang?: SiteLocale; variant?: 'default' | 'cards' }
const { lang = 'en', variant = 'default' } = Astro.props;

const englishProducts = {
  pipedrive: {
    eyebrow: 'Customer relationship management',
    headline: 'The easy and effective CRM for closing deals.',
    lead: 'Track your sales pipeline, optimise leads, manage deals and automate your sales process so you can focus on selling.',
    demo: 'Book a demo',
  },
  learnie: {
    eyebrow: 'Learning and knowledge sharing',
    headline: 'Learning that feels natural, not like a system.',
    lead: 'A mobile-first learning platform that preserves valuable experience, improves onboarding and supports continuous learning without complex traditional training systems.',
    demo: 'Book a demo',
  },
};

const products = lang === 'en' ? englishProducts : localizedPagesCopy[lang as LocalizedLandingCode];
const sectionCopy = {
  en: { eyebrow: 'Featured solutions', title: 'One strong solution for every real need.', lead: 'Our portfolio is small on purpose. Every product earns its place through usefulness, fit and long-term value.', pipedrive: 'Explore Pipedrive', learnie: 'Explore Learnie' },
  sr: { eyebrow: 'Odabrana rešenja', title: 'Jedno snažno rešenje za svaku stvarnu potrebu.', lead: 'Naš portfolio je namerno mali. Svaki proizvod zaslužuje svoje mesto kroz korisnost, usklađenost i dugoročnu vrednost.', pipedrive: 'Istražite Pipedrive', learnie: 'Istražite Learnie' },
  es: { eyebrow: 'Soluciones seleccionadas', title: 'Una solución sólida para cada necesidad real.', lead: 'Nuestra cartera es pequeña a propósito. Cada producto se gana su lugar por su utilidad, adecuación y valor a largo plazo.', pipedrive: 'Explorar Pipedrive', learnie: 'Explorar Learnie' },
  de: { eyebrow: 'Ausgewählte Lösungen', title: 'Eine starke Lösung für jeden echten Bedarf.', lead: 'Unser Portfolio ist bewusst klein. Jedes Produkt verdient seinen Platz durch Nutzen, Passgenauigkeit und langfristigen Wert.', pipedrive: 'Pipedrive entdecken', learnie: 'Learnie entdecken' },
  ru: { eyebrow: 'Отобранные решения', title: 'Одно сильное решение для каждой реальной задачи.', lead: 'Наш портфель намеренно небольшой. Каждый продукт занимает свое место благодаря пользе, соответствию задачам и долгосрочной ценности.', pipedrive: 'Подробнее о Pipedrive', learnie: 'Подробнее о Learnie' },
} satisfies Record<SiteLocale, { eyebrow: string; title: string; lead: string; pipedrive: string; learnie: string }>;
const section = sectionCopy[lang];
const controls = {
  en: ['Previous solution', 'Next solution'],
  sr: ['Prethodno rešenje', 'Sledeće rešenje'],
  es: ['Solución anterior', 'Siguiente solución'],
  de: ['Vorherige Lösung', 'Nächste Lösung'],
  ru: ['Предыдущее решение', 'Следующее решение'],
}[lang];
const href = (route: string) => routeFor(lang, route);
---

<section class:list={['solutions section', { 'solutions--cards': variant === 'cards' }]} id="solutions">
  <div class="container">
    <div class="solutions-head">
      <div><p class="eyebrow">{section.eyebrow}</p><h2 class="section-title">{section.title}</h2></div>
      <p>{section.lead}</p>
    </div>
    <div class="solution-list" id="featured-solutions-track" tabindex={variant === 'cards' ? '0' : undefined} role={variant === 'cards' ? 'region' : undefined} aria-label={variant === 'cards' ? section.eyebrow : undefined}>
      <article class="solution solution--pipedrive" aria-label="Pipedrive">
        <div class="solution-name solution-logo solution-logo--pipedrive"><img src="/partners/pipedrive-logo.svg" width="121" height="26" alt="Pipedrive" /></div>
        <div>
          <span>{products.pipedrive.eyebrow}</span>
          <h3>{products.pipedrive.headline}</h3>
          <p>{products.pipedrive.lead}</p>
          <div class="solution-actions"><a class="button" href={`${href('/contact')}?solution=pipedrive#start-a-conversation`}>{products.pipedrive.demo}</a><a class="text-link" href={href('/solutions/pipedrive')}>{section.pipedrive}</a></div>
        </div>
      </article>
      <article class="solution solution--learnie" aria-label="Learnie">
        <div class="solution-name solution-logo solution-logo--learnie">
          <img src="/partners/learnie-logo.png" width="350" height="125" alt="Learnie — Community Microlearning" />
        </div>
        <div>
          <span>{products.learnie.eyebrow}</span>
          <h3>{products.learnie.headline}</h3>
          <p>{products.learnie.lead}</p>
          <div class="solution-actions"><a class="button" href={`${href('/contact')}?solution=learnie#start-a-conversation`}>{products.learnie.demo}</a><a class="text-link" href={href('/solutions/learnie')}>{section.learnie}</a></div>
        </div>
      </article>
    </div>
    {variant === 'cards' && <div class="carousel-controls" hidden>
      <button type="button" class="carousel-arrow" data-step="-1" aria-label={controls[0]} aria-controls="featured-solutions-track"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg></button>
      <div class="carousel-dots">
        <button type="button" class="carousel-dot" data-slide="0" aria-label="Pipedrive" aria-current="true" aria-controls="featured-solutions-track"><span /></button>
        <button type="button" class="carousel-dot" data-slide="1" aria-label="Learnie" aria-controls="featured-solutions-track"><span /></button>
      </div>
      <button type="button" class="carousel-arrow" data-step="1" aria-label={controls[1]} aria-controls="featured-solutions-track"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg></button>
      <span class="carousel-status" aria-live="polite" aria-atomic="true"></span>
    </div>}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.solutions--cards').forEach(section => {
    const track = section.querySelector<HTMLElement>('.solution-list')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.solution'));
    const controls = section.querySelector<HTMLElement>('.carousel-controls')!;
    const dots = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    const arrows = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-step]'));
    const status = controls.querySelector<HTMLElement>('.carousel-status')!;
    let active = 0;
    const position = (index: number) => Math.min(slides[index].offsetLeft - slides[0].offsetLeft, track.scrollWidth - track.clientWidth);
    const update = () => {
      active = slides.reduce((nearest, _, index) => Math.abs(position(index) - track.scrollLeft) < Math.abs(position(nearest) - track.scrollLeft) ? index : nearest, 0);
      dots.forEach((dot, index) => index === active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current'));
      arrows[0].disabled = active === 0;
      arrows[1].disabled = active === slides.length - 1;
    };
    const go = (index: number) => track.scrollTo({ left: position(Math.max(0, Math.min(index, slides.length - 1))), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));
    arrows.forEach(button => button.addEventListener('click', () => go(active + Number(button.dataset.step))));
    track.addEventListener('keydown', event => {
      if (event.target !== track) return;
      const target = { ArrowLeft: active - 1, ArrowRight: active + 1, Home: 0, End: slides.length - 1 }[event.key];
      if (target !== undefined) { event.preventDefault(); go(target); }
    });
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('scrollend', () => { status.textContent = `${slides[active].getAttribute('aria-label')} · ${active + 1} / ${slides.length}`; });
    new ResizeObserver(update).observe(track);
    track.classList.add('is-enhanced');
    controls.hidden = false;
    update();
  });
</script>

<style>
  .solutions-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 3rem; }
  .solutions-head > p { max-width: 430px; margin: 0; color: var(--muted); line-height: 1.6; }
  .solution-list { margin-top: 5rem; border-top: 1px solid var(--line); }
  .solution { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 4.5vw, 5rem); padding: clamp(3rem, 7vw, 7rem); border-bottom: 1px solid var(--line); }
  .solution--pipedrive { position: relative; overflow: hidden; background: radial-gradient(circle at 102% 112%, rgba(104,97,242,.2) 0 26%, transparent 26.2%), linear-gradient(118deg, #d7f9d3 0 62%, #cfd0f9 100%); color: #192435; }
  .solution--pipedrive::before { position: absolute; top: 0; right: 0; left: 0; height: .35rem; background: linear-gradient(90deg, #017737, #6861f2); content: ""; }
  .solution--learnie { position: relative; overflow: hidden; background: radial-gradient(circle at 102% -16%, rgba(0,138,18,.12) 0 28%, transparent 28.2%), linear-gradient(118deg, #f5faf4 0 62%, #def1dc 100%); color: #24432b; }
  .solution--learnie::before { position: absolute; top: 0; right: 0; left: 0; height: .35rem; background: linear-gradient(90deg, #008a12, #0e8b44); content: ""; }
  .solution-name { align-self: center; color: #0a6241; font-size: clamp(3.3rem, 7vw, 7.2rem); font-weight: 800; letter-spacing: -.075em; }
  .solution-logo img { width: min(100%, clamp(19rem, 33vw, 31rem)); height: auto; display: block; }
  .solution-logo--pipedrive img { width: min(80%, 288px); }
  .solution--pipedrive > div:last-child > span { color: #017737; }
  .solution--pipedrive p { color: rgba(25,36,53,.76); }
  .solution--pipedrive .button { border-color: #6861f2; background: #6861f2; color: var(--white); }
  .solution--pipedrive .button:hover, .solution--pipedrive .button:focus-visible { border-color: #413d99; background: #413d99; color: var(--white); }
  .solution--pipedrive .text-link { color: #413d99; }
  .solution-logo--learnie img { width: min(80%, 288px); }
  .solution--learnie > div:last-child > span { color: #008a12; }
  .solution--learnie p { color: #536657; }
  .solution--learnie .button { border-color: #008a12; background: #008a12; color: var(--white); }
  .solution--learnie .button:hover, .solution--learnie .button:focus-visible { border-color: #006e0e; background: #006e0e; color: var(--white); }
  .solution--learnie .text-link { color: #006e0e; }
  .solution > div:last-child > span { color: var(--accent); font-size: .68rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .solution h3 { max-width: 15ch; margin: 1rem 0; font-size: clamp(2rem, 3.7vw, 3.8rem); letter-spacing: -.05em; line-height: 1; }
  .solution p { max-width: 580px; color: var(--muted); line-height: 1.65; }
  .solution-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
  @media (max-width: 900px) {
    .solution { grid-template-columns: 1fr; }
    .solutions-head { align-items: flex-start; flex-direction: column; }
    .solution-logo img { width: min(100%, 27rem); }
    .solution-logo--pipedrive img { width: min(100%, 230px); }
    .solution-logo--learnie img { width: min(100%, 230px); }
  }
  .solutions--cards { padding: clamp(3.5rem, 6vw, 5.5rem) 0; }
  .solutions--cards .solutions-head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(2rem, 6vw, 6rem); }
  .solutions--cards .section-title { max-width: 23ch; font-size: clamp(2rem, 3.5vw, 3.2rem); line-height: 1.02; }
  .solutions--cards .solution-list { position: relative; display: flex; gap: 1.5rem; margin-top: 2.5rem; border: 0; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: var(--accent) transparent; padding: 4px 4px 18px; }
  .solutions--cards .solution-list:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 20px; }
  .solutions--cards .solution-list.is-enhanced { scrollbar-width: none; }
  .solutions--cards .solution-list.is-enhanced::-webkit-scrollbar { display: none; }
  .solutions--cards .solution { flex: 0 0 74%; scroll-snap-align: start; }
  .carousel-controls:not([hidden]) { display: flex; align-items: center; justify-content: center; width: fit-content; margin: 1.5rem auto 0; padding: 5px 10px; border: 1px solid rgba(192,68,22,.2); border-radius: 999px; background: linear-gradient(135deg, #fff, #fff3e9); box-shadow: 0 4px 16px rgba(93,57,40,.07); }
  .carousel-controls button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer; }
  .carousel-controls button:hover:not(:disabled) { background: #ffe5d3; }
  .carousel-controls button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .carousel-controls button:disabled { opacity: .3; cursor: default; }
  .carousel-arrow svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .carousel-dots { display: flex; margin: 0 8px; }
  .carousel-dot span { width: 9px; height: 9px; border-radius: 50%; background: #a39791; }
  .carousel-dot[aria-current] span { background: var(--accent); box-shadow: 0 0 0 4px rgba(192,68,22,.1); }
  .carousel-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .solutions--cards .solution { display: flex; flex-direction: column; min-width: 0; gap: 1.75rem; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid rgba(255,255,255,.9); border-radius: 18px; box-shadow: 0 10px 35px rgba(93,57,40,.045); }
  .solutions--cards .solution--pipedrive { background: radial-gradient(ellipse at 100% 0%, rgba(1,119,55,.09), transparent 60%), rgba(255,255,255,.95); }
  .solutions--cards .solution--learnie { background: radial-gradient(ellipse at 100% 0%, rgba(0,138,18,.08), transparent 60%), rgba(255,255,255,.95); }
  .solutions--cards .solution::before { content: none; }
  .solutions--cards .solution-logo { display: flex; align-items: center; min-height: 72px; align-self: stretch; }
  .solutions--cards .solution-logo--pipedrive img { width: min(100%, 190px); }
  .solutions--cards .solution-logo--learnie img { width: min(100%, 210px); }
  .solutions--cards .solution > div:last-child { display: flex; flex-direction: column; align-items: flex-start; flex: 1; min-width: 0; }
  .solutions--cards .solution h3 { max-width: 24ch; margin: .75rem 0 1rem; font-size: clamp(1.6rem, 2.2vw, 2.1rem); line-height: 1.08; overflow-wrap: anywhere; }
  .solutions--cards .solution p { margin: 0 0 1.5rem; line-height: 1.6; }
  .solutions--cards .solution-actions { margin-top: auto; gap: 1rem; padding-top: .5rem; }
  .solutions--cards .solution--pipedrive > div:last-child > span { color: #017737; }
  .solutions--cards .solution--learnie > div:last-child > span { color: #006e0e; }
  .solutions--cards .solution--pipedrive .button { background: #514ac4; border-color: #514ac4; }
  .solutions--cards .solution--pipedrive .button:hover, .solutions--cards .solution--pipedrive .button:focus-visible { background: #413d99; border-color: #413d99; }
  .solutions--cards .solution--learnie .button { background: #006e0e; border-color: #006e0e; }
  .solutions--cards .solution--learnie .button:hover, .solutions--cards .solution--learnie .button:focus-visible { background: #00590b; border-color: #00590b; }
  @media (max-width: 900px) {
    .solutions--cards .solutions-head, .solutions--cards .solution-list { grid-template-columns: minmax(0, 1fr); }
    .solutions--cards .solutions-head { gap: 1.5rem; }
    .solutions--cards .solution-logo { min-height: 0; }
    .solutions--cards .solution { flex-basis: 90%; }
    .solutions--cards .solution-list { gap: 1rem; }
  }
  @media (max-width: 480px) { .solutions--cards .solution-actions { flex-direction: column; align-items: flex-start; } }
</style>
