---
import { homeCopy } from '../data/home';
import { routeFor, type SiteLocale } from '../data/localization';
interface Props { lang?: SiteLocale }
const { lang = 'en' } = Astro.props;
const copy = homeCopy[lang].solutions;
const products = ['pipedrive', 'learnie'] as const;
---
<section class="solutions solutions--cards" id="solutions">
  <div class="container">
    <div class="solutions-head"><p class="eyebrow">{copy.eyebrow}</p><h2 class="section-title">{copy.title}</h2></div>
    <div class="solution-list" id="featured-solutions-track" tabindex="0" role="region" aria-label={copy.eyebrow}>
      {products.map(product => <article class={`solution solution--${product}`} aria-label={product === 'pipedrive' ? 'Pipedrive' : 'Learnie'}>
        <div class="solution-copy">
          <h3>{copy[product].headline}</h3><p>{copy[product].text}</p>
          <div class="solution-actions">
            <a class="button button--primary" href={routeFor(lang, `/solutions/${product}`)}>{copy[product].explore}</a>
            <a class="demo-link" href={`${routeFor(lang, '/contact')}?solution=${product}#start-a-conversation`}>{copy.demo}</a>
          </div>
        </div>
        <div class="solution-logo">
          {product === 'pipedrive' ? <img src="/partners/pipedrive-logo.svg" width="121" height="26" alt="Pipedrive" /> : <img src="/partners/learnie-logo.png" width="350" height="125" alt="Learnie — Community Microlearning" />}
        </div>
      </article>)}
    </div>
    <div class="carousel-controls" hidden>
      <button type="button" data-step="-1" aria-controls="featured-solutions-track">{copy.previous}</button>
      <div class="carousel-dots">{products.map((product, index) => <button type="button" class="carousel-dot" data-slide={index} aria-label={product === 'pipedrive' ? 'Pipedrive' : 'Learnie'} aria-current={index === 0 ? 'true' : undefined} aria-controls="featured-solutions-track"><span /></button>)}</div>
      <button type="button" data-step="1" aria-controls="featured-solutions-track">{copy.next}</button>
      <span class="carousel-status" aria-live="polite" aria-atomic="true"></span>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.solutions--cards').forEach(section => {
    const track = section.querySelector<HTMLElement>('.solution-list')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.solution'));
    const controls = section.querySelector<HTMLElement>('.carousel-controls')!;
    const dots = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    const steps = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-step]'));
    const status = controls.querySelector<HTMLElement>('.carousel-status')!;
    let active = 0;
    let resizing = false;
    const position = (index: number) => slides[index].offsetLeft - slides[0].offsetLeft;
    const update = () => {
      if (resizing) return;
      active = slides.reduce((nearest, _, index) => Math.abs(position(index) - track.scrollLeft) < Math.abs(position(nearest) - track.scrollLeft) ? index : nearest, 0);
      dots.forEach((dot, index) => index === active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current'));
      steps[0].disabled = active === 0;
      steps[1].disabled = active === slides.length - 1;
    };
    const go = (index: number) => track.scrollTo({ left: position(Math.max(0, Math.min(index, slides.length - 1))), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));
    steps.forEach(button => button.addEventListener('click', () => go(active + Number(button.dataset.step))));
    track.addEventListener('keydown', event => {
      if (event.target !== track) return;
      const target = { ArrowLeft: active - 1, ArrowRight: active + 1, Home: 0, End: slides.length - 1 }[event.key];
      if (target !== undefined) { event.preventDefault(); go(target); }
    });
    track.addEventListener('focusin', event => {
      const index = slides.findIndex(slide => slide.contains(event.target as Node));
      if (index >= 0) track.scrollTo({ left: position(index), behavior: 'instant' });
    });
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('scrollend', () => { status.textContent = `${slides[active].getAttribute('aria-label')} · ${active + 1} / ${slides.length}`; });
    new ResizeObserver(() => {
      resizing = true;
      track.scrollTo({ left: position(active), behavior: 'instant' });
      requestAnimationFrame(() => { resizing = false; update(); });
    }).observe(track);
    track.classList.add('is-enhanced');
    controls.hidden = false;
    update();
  });
</script>
<style>
  .solutions { padding: clamp(3.5rem, 6vw, 5.5rem) 0; }
  .section-title { max-width: 24ch; font-size: clamp(2rem, 3.5vw, 3.2rem); line-height: 1.02; }
  .solution-list { position: relative; display: flex; gap: 1.5rem; max-width: 1000px; margin: 2.5rem auto 0; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: var(--accent) transparent; border-radius: 22px; }
  .solution-list:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .solution-list.is-enhanced { scrollbar-width: none; }
  .solution-list.is-enhanced::-webkit-scrollbar { display: none; }
  .solution { --card-wave: #ffdcc8; flex: 0 0 100%; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; padding: clamp(1.5rem, 2.8vw, 2.5rem); scroll-snap-align: start; scroll-snap-stop: always; border: 1px solid #e9dfd6; border-radius: 22px; background: radial-gradient(ellipse 75% 160% at 15% -45%, #fffaf3 73%, transparent 74%), radial-gradient(ellipse 70% 120% at 95% 150%, var(--card-wave) 68%, transparent 69%), linear-gradient(120deg, #fffaf3, #fff0e1); }
  .solution--learnie { --card-wave: #e6efcf; }
  .solution-copy { min-width: 0; width: 100%; }
  .solution h3 { max-width: 30ch; margin: 0 0 .75rem; font-size: clamp(1.75rem, 2.7vw, 2.5rem); letter-spacing: -.045em; line-height: 1.08; }
  .solution p { margin: 0; max-width: 760px; color: var(--muted); line-height: 1.55; }
  .solution-logo { order: -1; display: flex; align-items: center; height: 44px; }
  .solution-logo img { width: auto; height: 44px; max-width: 210px; object-fit: contain; object-position: left center; }
  .solution-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.25rem; }
  .demo-link { display: inline-flex; align-items: center; min-height: 44px; padding: .75rem 1rem; border-radius: 999px; text-decoration: underline; text-underline-offset: .2em; color: var(--accent-dark); font-size: .85rem; transition: background .2s ease, color .2s ease; }
  .demo-link:hover, .demo-link:focus-visible { background: #ffead7; color: var(--ink); }
  .carousel-controls:not([hidden]) { display: flex; align-items: center; justify-content: center; gap: .5rem; margin-top: 1.25rem; }
  .carousel-controls button { display: grid; place-items: center; min-width: 44px; min-height: 44px; padding: .5rem .7rem; border: 0; border-radius: 999px; background: transparent; color: var(--accent-dark); cursor: pointer; font-size: .8rem; }
  .carousel-controls button:hover:not(:disabled) { background: #ffe5d3; }
  .carousel-controls button:disabled { opacity: .4; cursor: default; }
  .carousel-dots { display: flex; }
  .carousel-dot span { width: 8px; height: 8px; border-radius: 50%; background: #9b8c82; }
  .carousel-dot[aria-current] span { background: var(--accent); box-shadow: 0 0 0 4px rgba(192,68,22,.1); }
  .carousel-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 480px) { .solution-actions { align-items: flex-start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .demo-link { transition: none; } }
</style>
