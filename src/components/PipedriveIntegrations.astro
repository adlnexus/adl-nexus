---
import { pipedriveTrialHref, type PipedriveDetailedCopy } from '../data/pipedrive';
interface Props { detail: PipedriveDetailedCopy; demoHref: string }
const { detail, demoHref } = Astro.props;
---
<section id="pipedrive-integrations" class="integrations" aria-labelledby="integrations-title">
  <div class="container">
    <p class="eyebrow">{detail.integrations.eyebrow}</p>
    <h2 id="integrations-title">{detail.integrations.title}</h2>
    <p class="lead">{detail.integrations.lead}</p>
    <ul>{detail.integrations.points.map(point => <li>{point}</li>)}</ul>
    <img class="logos" src="/partners/pipedrive/integrations.avif" width="1440" height="650" loading="lazy" alt="Slack, Zoom, Gmail, Zapier, Asana, Trello, Microsoft Teams, HubSpot, Intercom, PandaDoc, Google Drive" />
    <p class="closing">{detail.integrations.closing}</p>
    <div class="actions"><a class="button demo" href={demoHref}>{detail.hero.demo}</a><a class="button trial" href={pipedriveTrialHref} target="_blank" rel="sponsored noopener noreferrer">{detail.hero.trial}</a></div>
  </div>
</section>
<style>
  .integrations { padding: clamp(3.5rem, 6vw, 6rem) 0; background: #faf8f1; color: #262626; text-align: center; scroll-margin-top: 7rem; --focus-color: #1f5b49; }
  .eyebrow { margin: 0 0 1rem; color: #1f5b49; font-weight: 750; }
  h2 { max-width: 1100px; margin: 0 auto; color: #1f5b49; font-size: clamp(2rem, 3.5vw, 3.5rem); line-height: 1.12; letter-spacing: -.04em; }
  .lead { max-width: 1020px; margin: 1.75rem auto; font-size: 1.1rem; line-height: 1.6; }
  ul { margin: 0 auto; padding: 0; max-width: 1100px; list-style: none; font-size: 1.05rem; line-height: 1.6; font-weight: 700; }
  li + li { margin-top: .35rem; }
  .logos { display: block; width: min(100%, 900px); height: auto; margin: clamp(2rem, 4vw, 3.5rem) auto; }
  .closing { max-width: 960px; margin: 0 auto 2rem; color: #182420; font-size: clamp(1.3rem, 2.2vw, 1.8rem); font-weight: 750; line-height: 1.3; }
  .actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; }
  .demo { background: #1f5b49; border-color: #1f5b49; color: white; }
  .demo:hover, .demo:focus-visible { background: #173f34; border-color: #173f34; }
  .trial { background: #f6e8c8; border-color: #f6e8c8; color: #1b2420; }
  .trial:hover, .trial:focus-visible { background: #ebd9af; border-color: #ebd9af; color: #1b2420; }
  @media (max-width: 600px) { li + li { margin-top: 1rem; } .actions .button { width: 100%; } }
</style>
