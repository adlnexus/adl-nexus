---
import type { PipedriveDetailedCopy } from '../data/pipedrive';
import { pipedriveIndustries } from '../data/pipedrive-industries';
interface Props { lang: 'en' | 'sr'; copy: PipedriveDetailedCopy['audiences'] }
const { lang, copy } = Astro.props;
const sr = lang === 'sr';
---
<section id="pipedrive-industries" class="industries" aria-labelledby="industry-title" data-industries>
  <div class="container heading"><p class="eyebrow">{copy.eyebrow}</p><h2 id="industry-title">{copy.title}</h2><p>{copy.lead}</p></div>
  <ul class="track" id="industry-track" data-track aria-label={sr ? 'Industrije — koristite strelice za listanje' : 'Industries — use arrow keys to browse'} tabindex="0">
    {pipedriveIndustries.map((industry, i) => <li data-card>
      <a href={industry.href} hreflang="en">
        <img src={industry.image} alt="" width="768" height="402" loading="lazy" />
        <h3>{copy.cards[i]}</h3>
        <span class="badge">{sr ? 'CRM Vodič EN' : 'CRM Playbook'}</span>
      </a>
    </li>)}
  </ul>
  <div class="controls" data-controls hidden>
    <button type="button" data-prev aria-controls="industry-track" aria-label={sr ? 'Prethodna industrija' : 'Previous industry'}>←</button>
    <span data-status aria-live="polite" aria-atomic="true">1 / 12</span>
    <button type="button" data-next aria-controls="industry-track" aria-label={sr ? 'Sledeća industrija' : 'Next industry'}>→</button>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-industries]').forEach(root => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let frame = 0;
    const update = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      current = cards.reduce((best, card, i) => Math.abs(card.offsetLeft + card.offsetWidth / 2 - center) < Math.abs(cards[best].offsetLeft + cards[best].offsetWidth / 2 - center) ? i : best, 0);
      cards.forEach((card, i) => card.classList.toggle('active', i === current));
      status.textContent = `${current + 1} / ${cards.length}`;
      prev.disabled = current === 0;
      next.disabled = current === cards.length - 1;
    };
    const go = (index: number, focus = false) => {
      const target = Math.max(0, Math.min(cards.length - 1, index));
      track.scrollTo({ left: cards[target].offsetLeft - (track.clientWidth - cards[target].offsetWidth) / 2, behavior: motion.matches ? 'instant' : 'smooth' });
      if (focus) cards[target].querySelector('a')?.focus({ preventScroll: true });
    };
    prev.addEventListener('click', () => go(current - 1));
    next.addEventListener('click', () => go(current + 1));
    track.addEventListener('keydown', event => {
      const keys: Record<string, number> = { ArrowLeft: current - 1, ArrowRight: current + 1, Home: 0, End: cards.length - 1 };
      if (!(event.key in keys)) return;
      event.preventDefault(); go(keys[event.key], true);
    });
    track.addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(update); }, { passive: true });
    new ResizeObserver(() => { track.scrollTo({left: cards[current].offsetLeft - (track.clientWidth - cards[current].offsetWidth) / 2, behavior: 'instant'}); update(); }).observe(track);
    root.classList.add('enhanced');
    root.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
    update();
  });
</script>
<style>
  .industries { padding: clamp(3.5rem, 6vw, 6rem) 0; background: #f0e9d6; color: #182420; --focus-color: #1f5b49; scroll-margin-top: 7rem; }
  .heading { text-align: center; }
  .eyebrow { margin: 0 0 1rem; font-weight: 750; color: #182420; }
  h2 { max-width: 1000px; margin: 0 auto; color: #1f5b49; font-size: clamp(2rem, 3.5vw, 3.5rem); line-height: 1.12; letter-spacing: -.04em; }
  .heading > p:last-child { margin: 1.25rem auto 0; max-width: 700px; line-height: 1.6; }
  .track { --card-width: min(64vw, 800px); display: flex; gap: 1.5rem; position: relative; list-style: none; margin: 2.5rem 0 0; padding: 1rem calc((100% - var(--card-width)) / 2) 1.5rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: calc((100% - var(--card-width)) / 2); }
  li { flex: 0 0 var(--card-width); min-width: 0; scroll-snap-align: center; }
  a { position: relative; display: block; aspect-ratio: 768 / 402; border-radius: 1rem; color: #1f5b49; background: #fff; text-decoration: none; }
  img { display: block; width: 100%; height: 100%; border-radius: inherit; object-fit: cover; }
  h3 { position: absolute; inset: 40% 3% auto; margin: 0; padding: .65rem 1rem; border: 2px solid #1f5b49; border-radius: 3rem; background: #fff; font-size: clamp(1rem, 2.3vw, 2rem); font-weight: 600; text-align: center; line-height: 1.15; }
  /* The source images include an English label. Cover its entire field with live localised text. */
  .badge { position: absolute; right: 0; bottom: 0; width: 40%; height: 20%; display: grid; place-items: center; padding: .2rem; border-radius: .9rem 0 1rem 0; background: #1f5b49; color: #fff; font-size: clamp(.65rem, 1.3vw, 1rem); font-weight: 750; }
  .enhanced li { transform: scale(.94); transition: transform .2s ease; }
  .enhanced li.active, .enhanced li:focus-within { transform: scale(1); }
  .controls { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-top: 1rem; }
  .controls[hidden] { display: none; }
  button { width: 48px; height: 48px; border: 1px solid #1f5b49; border-radius: 50%; color: #1f5b49; background: white; font-size: 1.5rem; cursor: pointer; }
  button:hover:not(:disabled) { background: #1f5b49; color: white; }
  button:disabled { opacity: .4; cursor: default; }
  [data-status] { min-width: 5ch; text-align: center; font-variant-numeric: tabular-nums; }
  @media (max-width: 700px) { .track { --card-width: 84vw; gap: .6rem; } h3 { inset: 25% 3% auto; padding: .5rem; font-size: 1rem; } }
  @media (prefers-reduced-motion: reduce) { .enhanced li { transition: none; } }
</style>
