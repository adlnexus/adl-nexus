---
import source from '../data/pipedrive-handoff.json';
import { pipedriveDetailedCopy, pipedriveTrialHref } from '../data/pipedrive';
import { routeFor } from '../data/localization';
interface Props { lang: 'en' | 'sr' | 'es' }
const { lang } = Astro.props; const sr = lang === 'sr';
const items = lang === 'es' ? pipedriveDetailedCopy.es.faq.items : sr ? [148,150,152,154,156].map(i=>({question:source[String(i) as keyof typeof source],answer:source[String(i+1) as keyof typeof source]})) : pipedriveDetailedCopy.en.faq.items.map((item,i)=> i===2 ? {...item,answer:'Pipedrive uses separate company databases, encrypted HTTPS connections and daily AWS backups. Hosting location depends on the region and account; Pipedrive Support can confirm where your data is stored. Current certifications include ISO/IEC 27001:2022 and ISO/IEC 27701:2019. See the Pipedrive Trust Center for current certification and security details.'} : i===3 ? {...item,answer:'Pipedrive offers email and live chat support 24/7. Phone support is available during published hours to eligible users on Premium and Ultimate plans. As your local partner, we can help with questions and practical issues. Further development or expansion of your setup is available as a separate service.'} : item);
const es = lang === 'es';
---
<section class="faq" id="pipedrive-faq"><div class="container"><h2>{es ? 'Preguntas frecuentes' : sr ? 'Često postavljana pitanja' : 'Frequently asked questions'}</h2><div class="questions">{items.map((item,i)=><details><summary>{item.question}</summary><div class="answer"><p>{item.answer}</p>{i===2 && <p><a href="https://trustcenter.pipedrive.com/">Pipedrive Trust Center</a> · <a href="https://support.pipedrive.com/en/article/how-secure-is-my-data-in-pipedrive">{es ? 'Alojamiento de datos' : sr?'Čuvanje podataka':'Data hosting'}</a></p>}{i===3 && <a href="https://support.pipedrive.com/en/contact-us">{es ? 'Disponibilidad del soporte de Pipedrive' : sr?'Dostupnost Pipedrive podrške':'Pipedrive support availability'}</a>}</div></details>)}</div><p class="closing">{es ? 'Pipedrive ayuda a empresas de todos los sectores a cerrar más ventas, trabajar de forma más organizada y mantener sus proyectos bajo control después de la venta.' : sr ? source['158'] : 'Pipedrive helps businesses in every industry close more deals, work with less chaos, and keep projects on track after the sale.'}</p><div class="actions"><a class="button" href={`${routeFor(lang,'/contact')}?solution=pipedrive#start-a-conversation`}>{es ? 'Solicita una demo' : sr?'Zakažite demo':'Book a demo'}</a><a class="button trial" href={pipedriveTrialHref} rel="sponsored">{es ? 'Pruébalo gratis durante 30 días' : sr?'Isprobajte besplatno 30 dana':'Try free for 30 days'}</a></div></div></section>
<style>
.faq { padding:clamp(3.5rem,6vw,6rem) 0;background:#faf8f1;color:#262626;--focus-color:#1f5b49;scroll-margin-top:7rem; }h2 { text-align:center;color:#1f5b49;font-size:clamp(2rem,3.5vw,3.5rem);line-height:1.12;letter-spacing:-.04em;margin:0 0 2.5rem; }.questions { max-width:950px;margin:auto; }details { border-bottom:1px solid #d5d6cc; }summary { cursor:pointer;padding:1.5rem 0;color:#1f5b49;font-weight:750;font-size:1.15rem; }.answer { padding:0 0 1.5rem;line-height:1.7; }.answer p { margin:0 0 1rem; }.answer a { text-decoration:underline; }.closing { max-width:850px;text-align:center;margin:3rem auto 1.5rem;font-size:1.3rem;line-height:1.5;font-weight:700;color:#1f5b49; }.actions { display:flex;justify-content:center;gap:1rem;flex-wrap:wrap; }.button { background:#1f5b49;border-color:#1f5b49;color:white; }.trial { background:#f6e8c8;border-color:#f6e8c8;color:#182420; }summary:focus-visible { outline:3px solid #1f5b49;outline-offset:3px; }
</style>
