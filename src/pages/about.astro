---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { localizedPagesCopy } from '../data/localized-pages';
import type { LocalizedLandingCode, SiteLocale } from '../data/localization';
interface Props { lang?: SiteLocale }
const { lang = 'en' } = Astro.props;
const english = {
  title: 'About us — ADL Nexus', eyebrow: 'About ADL', heroFirst: 'Small portfolio.', heroAccent: 'Serious commitment.', lead: 'We connect organisations with carefully selected software and give technology companies the market presence they need to grow.',
  introTitle: 'An independent partner on both sides of the table.', intro: ['ADL Nexus was created around a simple idea: more choice is not always more helpful. Organisations deserve a trusted recommendation, not an overwhelming catalogue. Technology companies deserve representation that is focused, informed and genuinely invested.', 'That is why we choose a single strong solution for each need and build long-term partnerships around it. Our independence keeps our advice clear. Our selectivity keeps our attention where it belongs.'],
  beliefEyebrow: 'What we believe', belief: '“The strongest partnerships are built when interests are aligned, expectations are clear and both sides are invested for the long term.”', principlesEyebrow: 'Our principles',
  principles: [
    { label: '01 / Selective', title: 'Depth over breadth.', text: 'A deliberately small portfolio means meaningful expertise and undivided commitment.' },
    { label: '02 / Transparent', title: 'Clarity from day one.', text: 'We communicate openly about opportunities, constraints and what success requires.' },
    { label: '03 / International', title: 'Local insight, wider view.', text: 'Our network and experience connect market nuance with international ambition.' },
  ], closing: { eyebrow: 'Start a conversation', title: 'Let’s build something that lasts.', text: 'Whether you are choosing technology or choosing a market, the right partner changes the outcome.', button: 'Contact us' },
};
const copy = lang === 'en' ? english : localizedPagesCopy[lang as LocalizedLandingCode].about;
---
<BaseLayout lang={lang} title={copy.title} description={copy.lead}>
  <section class="page-hero"><div class="container"><p class="eyebrow">{copy.eyebrow}</p><h1 class="page-title">{copy.heroFirst}<br /><span class="accent">{copy.heroAccent}</span></h1><p class="lead">{copy.lead}</p></div></section>
  <section class="section"><div class="container split-intro"><h2 class="section-title">{copy.introTitle}</h2><div class="copy"><p>{copy.intro[0]}</p><p>{copy.intro[1]}</p></div></div></section>
  <section class="belief"><div class="container"><p class="eyebrow">{copy.beliefEyebrow}</p><blockquote>{copy.belief}</blockquote></div></section>
  <section class="section"><div class="container"><p class="eyebrow">{copy.principlesEyebrow}</p><div class="stat-grid">{copy.principles.map((principle) => <article class="plain-card"><span class="num">{principle.label}</span><h3>{principle.title}</h3><p>{principle.text}</p></article>)}</div></div></section>
  <ClosingCta lang={lang} eyebrow={copy.closing.eyebrow} title={copy.closing.title} text={copy.closing.text} buttonLabel={copy.closing.button} />
</BaseLayout>
<style>
  .belief { padding: clamp(6rem, 12vw, 11rem) 0; background: var(--accent); color: var(--white); }
  .belief .eyebrow { color: var(--white); }
  blockquote { max-width: 16ch; margin: 2rem 0 0; font-size: clamp(2.5rem, 5.5vw, 5.5rem); font-weight: 700; letter-spacing: -.06em; line-height: .98; }
</style>
