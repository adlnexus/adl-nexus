---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFooter from '../components/HeroFooter.astro';
import { contactEmails, enquiryRecipients } from '../data/contact';
import { localizedPagesCopy } from '../data/localized-pages';
import type { LocalizedLandingCode, SiteLocale } from '../data/localization';
interface Props { lang?: SiteLocale }
const { lang = 'en' } = Astro.props;
const solution = Astro.url.searchParams.get('solution') || '';
const english = {
  title: 'Contact — ADL Nexus', description: 'Start a conversation with ADL Nexus about software, market entry or commercial growth.', eyebrow: 'Contact', heroFirst: 'Let’s find the', heroAccent: 'right next step.', lead: 'Tell us about the software challenge, market opportunity or commercial goal you are working through.',
  start: 'Start a conversation', brief: 'A short brief is enough.', response: 'We’ll respond with the questions that matter and suggest a focused first conversation.', email: 'Email', based: 'Based in', location: 'Belgrade · working internationally',
  fields: { name: 'Name', company: 'Company', workEmail: 'Work email', topic: 'I’m interested in', message: 'What are you working on?' },
  topics: ['A general conversation', 'A Pipedrive demo', 'A Learnie demo', 'Market entry and sales representation'], submit: 'Prepare email', note: 'Submitting opens your email app with the enquiry prepared. No information is stored by this website.', subject: 'ADL Nexus enquiry',
};
const copy = lang === 'en' ? english : localizedPagesCopy[lang as LocalizedLandingCode].contact;
---
<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="page-hero">
    <div class="page-hero-copy container"><p class="eyebrow">{copy.eyebrow}</p><h1 class="page-title">{copy.heroFirst}<br /><span class="accent">{copy.heroAccent}</span></h1><p class="lead">{copy.lead}</p></div>
    <HeroFooter lang={lang} context="contact" />
  </section>
  <section class="section contact-section" id="start-a-conversation"><div class="container contact-grid"><div><p class="eyebrow">{copy.start}</p><h2 class="section-title">{copy.brief}</h2><p class="lead">{copy.response}</p><div class="contact-details"><span>{copy.email}</span>{contactEmails.map((email) => <a href={`mailto:${email}`}>{email}</a>)}<span>{copy.based}</span><p>{copy.location}</p></div></div><form class="contact-form" id="contact-form" data-recipients={enquiryRecipients} data-subject={copy.subject} data-name-label={copy.fields.name} data-company-label={copy.fields.company} data-email-label={copy.fields.workEmail}><div class="field"><label for="name">{copy.fields.name}</label><input id="name" name="name" autocomplete="name" required /></div><div class="field"><label for="company">{copy.fields.company}</label><input id="company" name="company" autocomplete="organization" /></div><div class="field field--wide"><label for="email">{copy.fields.workEmail}</label><input id="email" name="email" type="email" autocomplete="email" required /></div><div class="field field--wide"><label for="topic">{copy.fields.topic}</label><select id="topic" name="topic"><option value="General conversation">{copy.topics[0]}</option><option value="Pipedrive demo" selected={solution === 'pipedrive'}>{copy.topics[1]}</option><option value="Learnie demo" selected={solution === 'learnie'}>{copy.topics[2]}</option><option value="Market entry and sales representation" selected={solution === 'market-entry'}>{copy.topics[3]}</option></select></div><div class="field field--wide"><label for="message">{copy.fields.message}</label><textarea id="message" name="message" required></textarea></div><div class="field--wide"><button class="button button--primary" type="submit">{copy.submit}</button><p class="form-note">{copy.note}</p></div></form></div></section>
</BaseLayout>
<style>
  .contact-section { background: var(--white); }
  .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(3rem, 8vw, 8rem); }
  .contact-details { display: grid; gap: .5rem; margin-top: 4rem; }
  .contact-details span { margin-top: 1.2rem; color: var(--accent); font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .contact-details a { font-size: clamp(1.25rem, 2vw, 2rem); font-weight: 700; }
  .contact-details p { margin: 0; color: var(--muted); }
  @media (max-width: 850px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
<script>
  const form = document.querySelector('#contact-form');
  const requestedSolution = new URLSearchParams(window.location.search).get('solution');
  const topic = form?.querySelector<HTMLSelectElement>('#topic');
  if (topic && requestedSolution === 'pipedrive') topic.value = 'Pipedrive demo';
  if (topic && requestedSolution === 'learnie') topic.value = 'Learnie demo';
  if (topic && requestedSolution === 'market-entry') topic.value = 'Market entry and sales representation';
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form as HTMLFormElement);
    const element = form as HTMLFormElement;
    const subject = `${element.dataset.subject} — ${data.get('topic')}`;
    const body = [`${element.dataset.nameLabel}: ${data.get('name')}`, `${element.dataset.companyLabel}: ${data.get('company')}`, `${element.dataset.emailLabel}: ${data.get('email')}`, '', String(data.get('message'))].join('\n');
    window.location.href = `mailto:${element.dataset.recipients}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
