---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — ADL Nexus" description="This page is not available. Return to ADL Nexus to find the right software and market support." robots="noindex, follow" notFound>
  <section class="not-found container">
    <p class="eyebrow">404</p><h1>Page not found.</h1>
    <p>This page is no longer available, or the address is incorrect.</p>
    <a class="button button--primary" href="/">Back to home</a>
  </section>
</BaseLayout>
<style>
  .not-found { min-height: 70svh; padding-block: 10rem 5rem; }
  h1 { font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -.05em; margin: 0 0 1.5rem; }
  p:not(.eyebrow) { margin-bottom: 2rem; line-height: 1.6; }
</style>
