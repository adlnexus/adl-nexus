---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PipedriveFaq from '../../components/PipedriveFaq.astro';
import PipedriveStories from '../../components/PipedriveStories.astro';
import PipedriveGettingStarted from '../../components/PipedriveGettingStarted.astro';
import PipedriveTrust from '../../components/PipedriveTrust.astro';
import PipedriveComparison from '../../components/PipedriveComparison.astro';
import PipedriveApproach from '../../components/PipedriveApproach.astro';
import PipedriveIndustries from '../../components/PipedriveIndustries.astro';
import PipedriveFeatures from '../../components/PipedriveFeatures.astro';
import PipedriveIntegrations from '../../components/PipedriveIntegrations.astro';
import { routeFor, type SiteLocale } from '../../data/localization';
import { pipedriveDetailedCopy, pipedriveTrialHref } from '../../data/pipedrive';

interface Props { lang?: SiteLocale }
const { lang = 'en' } = Astro.props;
const detail = pipedriveDetailedCopy[lang];
const demoHref = `${routeFor(lang, '/contact')}?solution=pipedrive#start-a-conversation`;
const pageTitle = detail.title;
const pageDescription = detail.description;
---

<BaseLayout lang={lang} title={pageTitle} description={pageDescription} brandVariant="green" footerVariant="pipedrive">
  <div class="pd-page">
      <section class="pd-hero pd-hero-template">
        <div class="container pd-hero-grid">
          <div>
            <h1>{detail.hero.headline}</h1>
            <p class="pd-lead">{detail.hero.lead}</p>
            <p class="pd-support">{detail.hero.support}</p>
            <div class="pd-actions">
              <a class="button pd-outline" href={demoHref}>{detail.hero.demo}</a>
              <div class="pd-trial-wrap">
                <a class="button pd-trial" href={pipedriveTrialHref} target="_blank" rel="sponsored noopener noreferrer">{detail.hero.trial}</a>
                <small>{detail.hero.trialNote}</small>
              </div>
            </div>
          </div>
          <div class="pd-product-visual">
            <img class="product" src="/partners/pipedrive/playbooks/psh-site-materials-2-ufcPDcxzMjJ0719q.png" width="1200" height="630" fetchpriority="high" alt={lang === 'es' ? 'Pipedrive en un portátil y un teléfono' : lang === 'sr' ? 'Pipedrive na laptopu i telefonu' : 'Pipedrive on a laptop and phone'} />
            <img class="partner" src="/partners/pipedrive/premier-partner.png" width="540" height="540" alt="Pipedrive Premier Partner — PartnerScaleHub" />
          </div>
        </div>
      </section>

    <PipedriveTrust lang={lang} text={detail.trust} />
    <PipedriveComparison lang={lang} detail={detail} demoHref={demoHref} />
    <PipedriveApproach lang={lang} detail={detail} contactHref={`${routeFor(lang, '/contact')}#start-a-conversation`} />
    <PipedriveIndustries lang={lang} copy={detail.audiences} />
    <PipedriveIntegrations detail={detail} demoHref={demoHref} />
    <PipedriveFeatures lang={lang} copy={detail.features} demoHref={demoHref} demoLabel={detail.hero.demo} />
    <PipedriveGettingStarted lang={lang} />
    <PipedriveStories lang={lang} />
    <PipedriveFaq lang={lang} />
  </div>
</BaseLayout>

<style>
.pd-page{background:#faf8f1;color:#192435;--focus-color:#1f5b49;}
.pd-hero{background:linear-gradient(110deg,#faf9f4,#f3eddd);padding:40px 0 12px;}
.pd-hero-grid{width:92%;max-width:1472px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.03fr);gap:24px;align-items:end;}
h1{font-size:clamp(3rem,4.25vw,4.5rem);line-height:1.12;letter-spacing:-.045em;color:#073d32;margin:0 0 26px;max-width:12em;}
.pd-lead{font-size:clamp(1.05rem,1.5vw,1.5rem);line-height:1.35;margin:0 0 24px;}
.pd-support{font-size:clamp(1.25rem,1.85vw,1.85rem);font-weight:750;line-height:1.25;margin:0;letter-spacing:-.025em;}
.pd-actions{display:flex;gap:clamp(16px,2.3vw,36px);align-items:flex-start;margin-top:40px;}
.pd-hero .button{min-height:58px;border:0;border-radius:999px;font-size:clamp(1.2rem,1.4vw,1.4rem);font-weight:750;letter-spacing:-.02em;text-transform:none;padding:14px 25px;white-space:normal;text-align:center;}
.pd-hero .button::after{content:none;}.pd-outline{background:#1b5a43;color:#fff;}.pd-outline:hover{background:#12412f;color:#fff;}
.pd-trial{background:linear-gradient(105deg,#b57800,#b47700);color:#fff;}.pd-trial:hover{background:#805100;color:#fff;}
.pd-actions>.button{flex:1;}.pd-trial-wrap{display:grid;gap:7px;flex:1.3;}.pd-trial-wrap .button{width:100%;}.pd-trial-wrap small{text-align:center;font-size:clamp(.8rem,1vw,1rem);font-weight:600;}
.pd-product-visual{position:relative;min-width:0;padding-top:90px;align-self:end;}.product{display:block;width:112%;max-width:none;height:auto;margin-left:-7%;}.partner{position:absolute;width:39%;height:auto;top:-80px;right:-7%;filter:drop-shadow(0 6px 14px #142e3344);}
@media(min-width:1600px){.pd-hero{padding-top:40px;}}
@media(max-width:1180px){.pd-hero-grid{align-items:center;}.pd-actions{flex-direction:column;gap:14px;margin-top:28px;}.pd-trial-wrap{width:100%;}.pd-hero .button{white-space:normal;text-align:center;}.pd-product-visual{padding-top:65px;}.partner{top:-10px;}}
@media(max-width:760px){.pd-hero{padding:32px 0 18px;}.pd-hero-grid{grid-template-columns:1fr;gap:24px;width:90%;}h1{font-size:clamp(2.6rem,7.5vw,3.8rem);}.pd-lead{font-size:1.1rem;line-height:1.5;}.pd-support{font-size:1.3rem;}.pd-actions{align-items:stretch;}.pd-hero .button{font-size:1.05rem;min-height:54px;}.pd-trial{background:#986100;}.pd-product-visual{padding-top:40px;}.product{width:107%;margin-left:-4%;}.partner{width:37%;right:-4%;top:-18px;}}
</style>
