---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { localizedPagesCopy } from '../../data/localized-pages';
import { routeFor, type LocalizedLandingCode, type SiteLocale } from '../../data/localization';
interface Props { lang?: SiteLocale }
const { lang = 'en' } = Astro.props;
const english = {
  title: 'Learnie — ADL Nexus', eyebrow: 'Featured solution · Learning', headline: 'Learning that feels social, useful and alive.', lead: 'A mobile-first learning platform that helps organisations preserve valuable experience, improve onboarding and support continuous learning without complex traditional training systems.', demo: 'Book a demo',
  visual: ['What I wish I knew in week one', 'Onboarding · 8 lessons', 'How our best people handle objections', 'Sales craft · 12 lessons', 'A smarter way to share experience', 'Team knowledge · 6 lessons'] as [string, string, string, string, string, string], introTitle: 'Your organisation already knows more than it can document.', intro: ['Important knowledge often lives in conversations, individual experience and informal habits. Learnie makes it easy to capture that knowledge and share it in a format people actually want to use.', 'ADL Nexus helps you explore the use cases that matter most—from onboarding and product knowledge to peer learning and preserving institutional memory.'] as [string, string], why: 'Why Learnie',
  benefits: [
    { label: '01', title: 'Capture experience', text: 'Turn valuable know-how into short, accessible learning that stays inside the organisation.' },
    { label: '02', title: 'Improve onboarding', text: 'Help new people learn from colleagues and reach confidence faster, wherever they work.' },
    { label: '03', title: 'Keep learning alive', text: 'Make sharing knowledge a lightweight, continuous habit instead of a once-a-year event.' },
  ], closing: { eyebrow: 'Start a conversation', title: 'Make what your people know easier to share.', text: 'Book a Learnie demo and explore a lighter way to build a learning organisation.', button: 'Contact us' },
};
const copy = lang === 'en' ? english : localizedPagesCopy[lang as LocalizedLandingCode].learnie;
const demoHref = `${routeFor(lang, '/contact')}?solution=learnie#start-a-conversation`;
---
<BaseLayout lang={lang} title={copy.title} description={copy.lead}>
  <section class="product-hero learnie">
    <div class="container product-grid">
      <div class="product-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <img class="wordmark" src="/partners/learnie-logo.png" width="350" height="125" alt="Learnie — Community Microlearning" />
        <h1>{copy.headline}</h1>
        <p>{copy.lead}</p>
        <a class="button learnie-button" href={demoHref}>{copy.demo}</a>
      </div>
      <div class="learning-stage" aria-hidden="true">
        <div class="learning-path"></div>
        <div class="learning-stack">
          {[0, 1, 2].map((i) => <article><span>{['01:42', '02:18', '00:56'][i]}</span><strong>{copy.visual[i * 2]}</strong><i>{copy.visual[(i * 2) + 1]}</i></article>)}
        </div>
      </div>
    </div>
  </section>
  <section class="section"><div class="container split-intro"><h2 class="section-title">{copy.introTitle}</h2><div class="copy"><p>{copy.intro[0]}</p><p>{copy.intro[1]}</p></div></div></section>
  <section class="section benefits"><div class="container"><p class="eyebrow">{copy.why}</p><div class="card-grid">{copy.benefits.map((benefit) => <article class="plain-card"><span class="num">{benefit.label}</span><h3>{benefit.title}</h3><p>{benefit.text}</p></article>)}</div></div></section>
  <ClosingCta lang={lang} eyebrow={copy.closing.eyebrow} title={copy.closing.title} text={copy.closing.text} buttonLabel={copy.closing.button} />
</BaseLayout>
<style>
  .product-hero { --learnie-green: #008a12; --learnie-logo-green: #0e8b44; --learnie-grey: #717171; position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden; padding: 9rem 0 5rem; background: linear-gradient(118deg, #fff 0 46%, #f1f9ef 76%, #dff2dc 100%); }
  .product-hero::before { position: absolute; top: 18%; right: -13vw; width: min(58vw, 780px); aspect-ratio: 1; border: clamp(2.5rem, 6vw, 6rem) solid rgba(0,138,18,.08); border-radius: 50%; content: ""; pointer-events: none; }
  .product-grid { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 6rem; }
  .product-copy, .learning-stage { position: relative; z-index: 1; }
  .product-hero .eyebrow { color: var(--learnie-green); }
  .wordmark { width: min(100%, 18rem); height: auto; margin: 0 0 2rem; }
  .product-hero h1 { max-width: 14ch; margin: 2rem 0 1rem; font-size: var(--hero-title-size); letter-spacing: -.055em; line-height: .98; }
  .product-hero p:not(.eyebrow) { max-width: 590px; color: var(--learnie-grey); line-height: 1.6; }
  .learnie-button { margin-top: 1.5rem; border-color: var(--learnie-green); background: var(--learnie-green); color: var(--white); }
  .learnie-button:hover, .learnie-button:focus-visible { border-color: #006e0e; background: #006e0e; color: var(--white); }
  .learning-stage { min-height: 520px; display: grid; align-items: center; padding: clamp(1.5rem, 4vw, 3.25rem); border: 1px solid rgba(0,138,18,.18); background: linear-gradient(145deg, rgba(255,255,255,.72), rgba(213,240,207,.72)); box-shadow: 0 2rem 5rem rgba(14,139,68,.08); }
  .learning-stage::before, .learning-stage::after { position: absolute; border-radius: 50%; content: ""; pointer-events: none; }
  .learning-stage::before { top: -2.25rem; right: -2.25rem; width: 9rem; height: 9rem; border: 2rem solid rgba(14,139,68,.12); }
  .learning-stage::after { bottom: 1rem; left: 1rem; width: 3rem; height: 3rem; background: rgba(0,138,18,.12); }
  .learning-path { position: absolute; top: 13%; right: 9%; bottom: 13%; width: 2px; background: linear-gradient(180deg, transparent, rgba(0,138,18,.45), transparent); }
  .learning-stack { position: relative; z-index: 1; display: grid; gap: 1rem; }
  .learning-stack article { min-height: 130px; display: grid; grid-template-columns: auto 1fr; gap: .5rem 1rem; align-content: center; padding: 1.5rem; border-left: .3rem solid var(--learnie-logo-green); background: var(--white); box-shadow: 0 16px 40px rgba(14,139,68,.09); }
  .learning-stack article:nth-child(2) { transform: translateX(1.5rem); }
  .learning-stack span { grid-row: 1 / 3; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; background: var(--learnie-green); color: var(--white); font-size: .7rem; font-weight: 800; }
  .learning-stack strong { align-self: end; font-size: 1.1rem; }
  .learning-stack i { color: var(--learnie-grey); font-size: .74rem; font-style: normal; }
  .benefits { --accent: #008a12; background: #f3f9f1; }
  .benefits .plain-card { border-top: .25rem solid #0e8b44; }
  @media (max-width: 850px) {
    .product-hero { padding-top: 8rem; }
    .product-grid { grid-template-columns: 1fr; gap: 3rem; }
    .learning-stage { min-height: auto; }
    .learning-stack article:nth-child(2) { transform: none; }
  }
  @media (max-width: 520px) {
    .wordmark { width: min(72vw, 16.5rem); }
    .learning-stage { padding: 1rem; }
    .learning-stack article { min-height: 118px; grid-template-columns: 2.8rem 1fr; padding: 1.1rem; }
    .learning-stack span { width: 2.8rem; height: 2.8rem; }
  }
</style>
