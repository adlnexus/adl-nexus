---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeContent from '../../components/HomeContent.astro';
import HomeHero from '../../components/HomeHero.astro';
import { landingCopy, localizedLandingCodes, type LocalizedLandingCode } from '../../data/localization';

export function getStaticPaths() {
  return localizedLandingCodes.map((lang) => ({ params: { lang }, props: { lang, copy: landingCopy[lang] } }));
}

interface Props {
  lang: LocalizedLandingCode;
  copy: (typeof landingCopy)[LocalizedLandingCode];
}

const { lang, copy } = Astro.props;
---
<BaseLayout lang={lang} title={copy.title} description={copy.description} footerVariant="home">
  <HomeHero
    lang={lang}
    eyebrow={copy.hero.eyebrow}
    first={copy.hero.first}
    accent={copy.hero.accent}
    support={copy.hero.support}
    cta={copy.hero.cta}
  />
  <HomeContent lang={lang} />
</BaseLayout>
