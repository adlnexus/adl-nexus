---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { landingCopy, localizedLandingCodes, routeFor, type LocalizedLandingCode } from '../../data/localization';

export function getStaticPaths() {
  return localizedLandingCodes.map((lang) => ({ params: { lang }, props: { lang, copy: landingCopy[lang] } }));
}

interface Props {
  lang: LocalizedLandingCode;
  copy: (typeof landingCopy)[LocalizedLandingCode];
}

const { lang, copy } = Astro.props;
const href = (route: string) => routeFor(lang, route);
---
<BaseLayout darkHeader lang={lang} title={copy.title} description={copy.description}>
  <section class="localized-hero">
    <div class="container">
      <p class="eyebrow">{copy.hero.eyebrow}</p>
      <h1 class="display">{copy.hero.first}<br /><span>{copy.hero.accent}</span></h1>
      <p>{copy.hero.support}</p>
      <a class="button button--red" href={href('/contact')}>{copy.hero.cta}</a>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <p class="eyebrow">{copy.audiences.eyebrow}</p>
      <div class="localized-grid">
        <article><span>{copy.audiences.organisations}</span><h2>{copy.audiences.organisationsTitle}</h2><p>{copy.audiences.organisationsText}</p></article>
        <article><span>{copy.audiences.tech}</span><h2>{copy.audiences.techTitle}</h2><p>{copy.audiences.techText}</p></article>
      </div>
    </div>
  </section>

  <section class="section localized-why" id="services">
    <div class="container">
      <p class="eyebrow">{copy.why.eyebrow}</p>
      <h2 class="section-title">{copy.why.title}</h2>
      <div class="localized-three">{copy.why.points.map((point) => <p>{point}</p>)}</div>
    </div>
  </section>

  <section class="section" id="solutions">
    <div class="container">
      <p class="eyebrow">{copy.products.eyebrow}</p>
      <div class="products">
        <a href={href('/solutions/pipedrive')}><strong>pipedrive</strong><span>{copy.products.pipedrive} ↗</span></a>
        <a href={href('/solutions/learnie')}><strong>Learnie•</strong><span>{copy.products.learnie} ↗</span></a>
      </div>
    </div>
  </section>

  <section class="localized-contact" id="contact">
    <div class="container">
      <p class="eyebrow">{copy.closing.eyebrow}</p>
      <h2>{copy.closing.title}</h2>
      <a class="button button--red" href={href('/contact')}>{copy.closing.cta}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .localized-hero { min-height: 100svh; display: flex; align-items: center; padding: 10rem 0 6rem; background: var(--ink); color: var(--white); }
  .localized-hero .display { max-width: 12ch; }
  .localized-hero .display span { color: var(--red); }
  .localized-hero p:not(.eyebrow) { max-width: 680px; margin: 2rem 0; color: #bdbdc2; font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 1.55; }
  .localized-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: 3rem; background: var(--line); }
  .localized-grid article { min-height: 440px; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(2rem, 5vw, 5rem); background: var(--white); }
  .localized-grid span { color: var(--red); font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .localized-grid h2 { max-width: 13ch; margin: 2rem 0; font-size: clamp(2.5rem, 5vw, 5rem); letter-spacing: -.06em; line-height: .95; }
  .localized-grid p { color: var(--muted); line-height: 1.6; }
  .localized-why { background: var(--red); color: var(--white); }
  .localized-why .eyebrow { color: var(--white); }
  .localized-three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 5rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,.4); }
  .localized-three p { max-width: 340px; line-height: 1.55; }
  .products { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3rem; }
  .products a { min-height: 330px; display: flex; flex-direction: column; justify-content: space-between; padding: 3rem; background: var(--white); }
  .products a:first-child { background: #e8f3ee; color: #0a6241; }
  .products a:last-child { background: #f1eafb; color: #492077; }
  .products strong { font-size: clamp(3rem, 7vw, 6rem); letter-spacing: -.07em; }
  .products span { font-size: .8rem; font-weight: 800; line-height: 1.4; text-transform: uppercase; }
  .localized-contact { padding: clamp(7rem, 14vw, 13rem) 0; background: var(--ink); color: var(--white); text-align: center; }
  .localized-contact h2 { max-width: 13ch; margin: 1rem auto 3rem; font-size: clamp(3rem, 7vw, 7rem); letter-spacing: -.065em; line-height: .93; }
  @media (max-width: 750px) { .localized-grid, .localized-three, .products { grid-template-columns: 1fr; } }
</style>
