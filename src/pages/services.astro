---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { localizedPagesCopy } from '../data/localized-pages';
import { routeFor, type LocalizedLandingCode, type SiteLocale } from '../data/localization';
interface Props { lang?: SiteLocale }
const { lang = 'en' } = Astro.props;
const english = {
  title: 'Services — ADL Nexus', description: 'Market entry, business development, sales representation and customer growth for technology companies.', eyebrow: 'Services', heroFirst: 'Local presence.', heroAccent: 'International ambition.', lead: 'Commercial support with focus, clarity and long-term commitment. We become the trusted extension of your team in the markets that matter.',
  introTitle: 'Your market team, without the distance.', intro: ['Entering a new market requires more than a contact list. It takes context, credibility, patient relationship-building and a clear understanding of how buying decisions are made locally.', 'ADL Nexus combines hands-on sales leadership with an established international network. We focus on a limited number of non-competing partners, giving every relationship the attention it deserves.'],
  items: [
    { label: 'Market entry', title: '', text: 'Understand the market, sharpen your position and enter with a practical route to the right customers.' },
    { label: 'Business development', title: '', text: 'Identify opportunities, build pipelines and create sustainable growth in selected markets.' },
    { label: 'Sales representation', title: '', text: 'Put experienced local people in front of prospects to represent your solution and close deals.' },
    { label: 'Partner development', title: '', text: 'Build and enable partner networks that extend reach without diluting your proposition.' },
    { label: 'Customer success & growth', title: '', text: 'Support onboarding, adoption and account growth to maximise long-term customer value.' },
  ], itemCta: 'Discuss your market', approach: 'How we work',
  principles: [
    { label: '01 / Focus', title: 'One category, one commitment.', text: 'We do not represent competing solutions that address the same organisational need.' },
    { label: '02 / Context', title: 'Strategy grounded in reality.', text: 'Every market plan is shaped by local buying behaviour, relationships and commercial conditions.' },
    { label: '03 / Continuity', title: 'Built beyond the first deal.', text: 'We support the customer relationship from first conversation through adoption and growth.' },
  ],
  closing: { eyebrow: 'Start a conversation', title: 'A better market entry starts with the right conversation.', text: 'One focused conversation can clarify the market you should enter next.', button: 'Contact us' },
};
const copy = lang === 'en' ? english : localizedPagesCopy[lang as LocalizedLandingCode].services;
const contactHref = `${routeFor(lang, '/contact')}?solution=market-entry#start-a-conversation`;
---
<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="page-hero"><div class="container"><p class="eyebrow">{copy.eyebrow}</p><h1 class="page-title">{copy.heroFirst}<br /><span class="accent">{copy.heroAccent}</span></h1><p class="lead">{copy.lead}</p></div></section>
  <section class="section"><div class="container split-intro"><h2 class="section-title">{copy.introTitle}</h2><div class="copy"><p>{copy.intro[0]}</p><p>{copy.intro[1]}</p></div></div></section>
  <section class="service-list"><div class="container">{copy.items.map((service, i) => <article><span>0{i + 1}</span><h2>{service.label}</h2><p>{service.text}</p><a href={contactHref}>{copy.itemCta} ↗</a></article>)}</div></section>
  <section class="section approach"><div class="container"><p class="eyebrow">{copy.approach}</p><div class="card-grid">{copy.principles.map((principle) => <article class="plain-card"><span class="num">{principle.label}</span><h3>{principle.title}</h3><p>{principle.text}</p></article>)}</div></div></section>
  <ClosingCta lang={lang} eyebrow={copy.closing.eyebrow} title={copy.closing.title} text={copy.closing.text} buttonLabel={copy.closing.button} />
</BaseLayout>
<style>
  .service-list { background: var(--white); }
  .service-list article { display: grid; grid-template-columns: 90px .85fr 1.15fr auto; align-items: center; gap: 2rem; padding: 3rem 0; border-top: 1px solid var(--line); }
  .service-list article:last-child { border-bottom: 1px solid var(--line); }
  .service-list span { color: var(--accent); font-size: .7rem; font-weight: 800; }
  .service-list h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.7rem); letter-spacing: -.045em; }
  .service-list p { max-width: 500px; margin: 0; color: var(--muted); line-height: 1.55; }
  .service-list a { font-size: .7rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .approach { background: #ece9e3; }
  @media (max-width: 850px) { .service-list article { grid-template-columns: 50px 1fr; } .service-list p, .service-list a { grid-column: 2; } }
</style>
