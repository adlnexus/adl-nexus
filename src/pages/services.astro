---
import BaseLayout from '../layouts/BaseLayout.astro';
import { servicesCopy } from '../data/services';
import { localizedPagesCopy } from '../data/localized-pages';
import { routeFor, type SiteLocale } from '../data/localization';
interface Props { lang?: SiteLocale }
const { lang = 'en' } = Astro.props;
const copy = servicesCopy[lang];
const metadata = lang === 'en' ? {
  title: 'Services — ADL Nexus', eyebrow: 'Services',
  description: 'Market entry, business development, sales representation and customer growth for technology companies.',
  closing: { eyebrow: 'Start a conversation' },
} : localizedPagesCopy[lang].services;
const contactHref = `${routeFor(lang, '/contact')}?solution=market-entry#start-a-conversation`;
---
<BaseLayout lang={lang} title={metadata.title} description={metadata.description} ribbonVariant="services">
  <section class="page-hero services-hero">
    <div class="hero-bands" aria-hidden="true"></div>
    <div class="page-hero-copy container"><p class="eyebrow">{metadata.eyebrow}</p><h1 class="page-title">{copy.heroFirst}<br /><span class="accent">{copy.heroAccent}</span></h1><p class="lead">{copy.lead}</p></div>
  </section>
  <div class="services-content">
    <section class="services-intro services-section"><div class="container split-intro"><h2 class="section-title">{copy.introTitle}</h2><div class="copy">{copy.intro.map(text => <p>{text}</p>)}</div></div></section>
    <!-- The separate post-introduction CTA awaits owner-supplied copy. -->
    <section class="service-list" aria-label={metadata.eyebrow}><div class="container services-grid">{copy.items.map(service => <article class="service-card"><h2>{service.title}</h2><p>{service.text}</p></article>)}</div></section>
    <section class="services-section services-approach"><div class="container"><h2 class="section-title">{copy.approach}</h2><div class="approach-grid">{copy.principles.map(principle => <article class="service-card"><h3>{principle.title}</h3><p>{principle.text}</p></article>)}</div><div class="approach-action"><a class="button button--primary" href={contactHref}>{copy.contact}</a></div></div></section>
  </div>
  <section class="services-closing">
    <div class="container services-closing-inner"><div><p class="eyebrow">{metadata.closing.eyebrow}</p><h2>{copy.closingTitle}</h2></div><div class="services-closing-action"><p class="closing-text">{copy.closingText}</p><a class="button button--primary" href={contactHref}>{copy.talk}</a></div></div>
  </section>
</BaseLayout>
<style>
  .services-hero::before { content: none; }
  .services-hero .hero-bands { z-index: -1; }
  .services-content { position: relative; background: var(--paper); }
  .services-content::before { content: ''; position: absolute; inset: 0; background: url('/brand/adl-nexus-home-flow.svg') center / 100% 100% no-repeat; pointer-events: none; }
  .services-section { padding: clamp(3.5rem, 6vw, 6rem) 0; }
  .services-intro .section-title { max-width: 13ch; }
  .services-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1.25rem; }
  .service-card { min-width: 0; padding: clamp(1.5rem, 2.5vw, 2.5rem); border: 1px solid #e4d9ca; border-radius: 20px; background: linear-gradient(145deg, #fcf9f3, #f7f1e7); box-shadow: 0 5px 18px rgba(83, 61, 40, .05); }
  .services-grid .service-card { grid-column: span 2; }
  .services-grid .service-card:nth-child(n+4) { grid-column: span 3; }
  .service-card h2, .service-card h3 { margin: 0 0 1rem; font-size: clamp(1.4rem, 2.1vw, 2rem); line-height: 1.12; letter-spacing: -.04em; overflow-wrap: anywhere; }
  .service-card p { margin: 0; line-height: 1.65; color: #49434a; }
  .approach-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-top: 2.5rem; }
  .approach-grid .service-card { background: linear-gradient(145deg, #fffdfb, #faf6ef); }
  .approach-action { margin-top: 2rem; text-align: center; }
  .services-closing { position: relative; padding: clamp(3.5rem, 6vw, 5.5rem) 0; background: #17191c url('/brand/adl-nexus-home-closing.svg') center / cover no-repeat; color: var(--white); text-align: left; --focus-color: var(--accent-on-dark); }
  .services-closing-inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .services-closing .eyebrow { color: var(--accent-on-dark); }
  .services-closing h2 { max-width: 20ch; margin: 0; font-size: clamp(2rem, 3.5vw, 3.2rem); line-height: 1.04; letter-spacing: -.05em; overflow-wrap: anywhere; }
  .closing-text { max-width: 430px; margin: 0 0 1.5rem; line-height: 1.55; color: #d0ced0; }
  @media (max-width: 1000px) { .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .services-grid .service-card, .services-grid .service-card:nth-child(n+4) { grid-column: auto; } .services-grid .service-card:last-child { grid-column: 1 / -1; } .approach-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 600px) { .services-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 900px) { .services-closing-inner { grid-template-columns: minmax(0, 1fr); } }
</style>
