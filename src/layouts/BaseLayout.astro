---
import Header from '../components/Header.astro';
import PipedriveNav from '../components/PipedriveNav.astro';
import PipedriveFooter from '../components/PipedriveFooter.astro';
import Footer from '../components/Footer.astro';
import HomeRibbons from '../components/HomeRibbons.astro';
import { equivalentLocaleRoute, localeCodes, socialMetadata, type SiteLocale } from '../data/localization';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  darkHeader?: boolean;
  brandVariant?: 'default' | 'green';
  footerVariant?: 'default' | 'home' | 'pipedrive';
  ribbonVariant?: 'home' | 'services' | 'contact';
  homepage?: boolean;
  notFound?: boolean;
  lang?: SiteLocale;
  robots?: string;
}

const {
  title = 'ADL Nexus — Software solutions and market growth',
  description = 'We help organisations find the right software and help technology companies enter and grow in new markets.',
  darkHeader = false,
  brandVariant = 'default',
  footerVariant = 'default',
  ribbonVariant = footerVariant === 'home' ? 'home' : undefined,
  homepage = false,
  notFound = false,
  lang = 'en',
  robots = 'index, follow, max-image-preview:large',
} = Astro.props;
if (!Astro.site) throw new Error('Astro site URL is required for canonical SEO metadata.');
const site = Astro.site;
const canonicalPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonicalUrl = new URL(canonicalPath, site);
const socialImageUrl = new URL('/og.png', site);
const sitemapUrl = new URL('/sitemap-index.xml', site);
const englishPlaybook = /^\/solutions\/pipedrive\/(?:knowledge-base\/[^/]+|workshop)\/$/.test(canonicalPath);
const pageLocales = englishPlaybook ? ['en'] as const : /^\/(?:sr\/)?solutions\/pipedrive\/(?:pricing|implementation|knowledge-base)\/$/.test(canonicalPath) ? localeCodes.filter(locale => locale !== 'es') : localeCodes;
const alternateFor = (locale: SiteLocale) => new URL(equivalentLocaleRoute(canonicalPath, locale), site);
const social = socialMetadata[lang];
const structuredData = canonicalPath === '/' && lang === 'en' ? JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.href}#organization`,
    name: 'ADL Nexus',
    url: site.href,
    logo: new URL('/brand/adl-nexus-logo.svg', site).href,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.href}#website`,
    name: 'ADL Nexus',
    url: site.href,
    publisher: { '@id': `${site.href}#organization` },
    inLanguage: [...localeCodes],
  },
]).replace(/</g, '\\u003c') : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        try {
          const homePath = /^\/(?:(?:sr|es)\/?)?$/;
          const previous = new URL(document.referrer);
          const cameFromHome = previous.origin === window.location.origin && homePath.test(previous.pathname);
          const currentIsHome = homePath.test(window.location.pathname);
          if (cameFromHome && !currentIsHome) document.documentElement.classList.add('from-home');
        } catch {}
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#fffdfb" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="sitemap" href={sitemapUrl.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ADL Nexus" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={social.openGraphLocale} />
    {pageLocales.filter((locale) => locale !== lang).map((locale) => <meta property="og:locale:alternate" content={socialMetadata[locale].openGraphLocale} />)}
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={social.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content={social.imageAlt} />
    {!notFound && pageLocales.map((locale) => <link rel="alternate" hreflang={locale} href={alternateFor(locale).href} />)}
    {!notFound && <link rel="alternate" hreflang="x-default" href={alternateFor('en').href} />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <title>{title}</title>
  </head>
  <body class:list={{ 'homepage': homepage, 'home-ribbon-page': !!ribbonVariant, 'services-ribbon-page': ribbonVariant === 'services', 'contact-ribbon-page': ribbonVariant === 'contact' }}>
    {footerVariant === 'pipedrive' ? <PipedriveNav lang={lang} /> : <Header dark={darkHeader} lang={lang} brandVariant={brandVariant} homepage={homepage} notFound={notFound} />}
    <main><slot /></main>
    {footerVariant === 'pipedrive' ? <PipedriveFooter lang={lang} /> : <Footer lang={lang} variant={footerVariant} />}
    {ribbonVariant && <HomeRibbons variant={ribbonVariant} />}
  </body>
</html>
